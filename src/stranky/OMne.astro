---
import Base from '../layouts/Base.astro';
import Portret from '../components/Portret.astro';
import Osa from '../components/Osa.astro';
import Obrazek from '../components/Obrazek.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { jazykZUrl, t } from '../i18n';

const lang = jazykZUrl(Astro.url);

const studium = t(
  lang,
  [
    { roky: '2018 – 2022', nazev: 'SPŠSE a VOŠ Liberec', popis: 'Technické lyceum se zaměřením na multimédia a web design. Tady to všechno začalo.' },
    { roky: '2022 – 2023', nazev: 'FJFI ČVUT', popis: 'Fakulta jaderná a fyzikálně inženýrská.\nZajímavá zkušenost, jenže to nebyl můj šálek espressa' },
    { roky: '2022 – 2025', nazev: 'VŠKK', popis: 'Grafický a mediální design. Souběžný začátek s FJFI, ale nakonec jsem pochopil, že tohle je cesta, která mě baví.' },
    { roky: '2025 – dnes', nazev: 'VŠE FIS', popis: 'UX výzkum a design. Učím se navrhovat podle toho, co lidé opravdu potřebují.' },
  ],
  [
    { roky: '2018 – 2022', nazev: 'SPŠSE a VOŠ Liberec', popis: 'Technical lyceum focused on multimedia and web design. This is where it all started.' },
    { roky: '2022 – 2023', nazev: 'FJFI ČVUT', popis: 'Faculty of Nuclear Sciences and Physical Engineering, Czech Technical University.\nAn interesting experience, but not my cup of espresso.' },
    { roky: '2022 – 2025', nazev: 'VŠKK', popis: 'Graphic and media design. I started it alongside FJFI, and in the end realised this was the path I truly enjoy.' },
    { roky: '2025 – present', nazev: 'VŠE FIS', popis: 'UX research and design. Learning to design around what people really need.' },
  ],
);
const prace = t(
  lang,
  [
    { nazev: 'Kreativní kancl', popis: 'Content creator.' },
    { nazev: 'Laba', popis: 'Social media specialist.' },
    { nazev: 'Czech IT Academy', popis: 'Externista v oblasti UX/UI a grafického designu' },
    { nazev: 'Freelance', popis: 'UX/UI, weby a vizuální identity' },
  ],
  [
    { nazev: 'Kreativní kancl', popis: 'Content creator.' },
    { nazev: 'Laba', popis: 'Social media specialist.' },
    { nazev: 'Czech IT Academy', popis: 'Freelance UX/UI and graphic designer' },
    { nazev: 'Freelance', popis: 'UX/UI, websites and visual identities' },
  ],
);
const smery = t(
  lang,
  [
    { nazev: 'Předávat design dál', popis: 'Workshopy o digitálním designu, výuka Figmy a hlavně způsob, jak o rozhraní přemýšlet. Chci, aby si lidé odnesli víc než jen klávesové zkratky.' },
    { nazev: 'Vést designový proces', popis: 'Práce s týmem, společná rozhodnutí a produkt, který nevzniká jako hromádka obrazovek, ale jako promyšlený celek.' },
  ],
  [
    { nazev: 'Passing design on', popis: 'Workshops on digital design, teaching Figma and, above all, a way of thinking about interfaces. I want people to take away more than keyboard shortcuts.' },
    { nazev: 'Leading the design process', popis: 'Working with a team, making decisions together and building a product that isn’t a pile of screens but a well-thought-out whole.' },
  ],
);
const fotky = [
  { src: '/img/o-mne/houpacka.webp', alt: t(lang, 'Na houpačce v horách', 'On a swing in the mountains'), cls: 'f1' },
  { src: '/img/o-mne/na-kole.webp', alt: t(lang, 'Na kole', 'On the bike'), cls: 'f2' },
  { src: '/img/o-mne/lyze.webp', alt: t(lang, 'Na běžkách', 'Cross-country skiing'), cls: 'f3' },
  { src: '/img/o-mne/hory.webp', alt: t(lang, 'V horách', 'In the mountains'), cls: 'f4' },
  { src: '/img/o-mne/stelvio.webp', alt: t(lang, 'Průsmyk Stelvio', 'Stelvio Pass'), cls: 'f5' },
];
---
<Base title={t(lang, 'O mně', 'About')} description={t(lang, 'Tomáš Jindrák: designér na pomezí UX, UI a grafiky. Studium, praxe a co mě baví mimo práci.', 'Tomáš Jindrák: a designer working across UX, UI and graphic design. Education, experience and what I enjoy outside of work.')}>
  <header class="container hero">
    <Portret class="hero__portret nacti" />
    <p class="bg-word hero__slovo" aria-hidden="true" data-pismena="zespodu">{t(lang, 'O mně', 'About')}</p>
    <h1 class="title-xl hero__nazev"><span class="maska"><span style="--d:0.15s">Tomáš Jindrák</span></span></h1>
    <p class="lead gradient-text gradient-text--soft hero__shrnuti nacti" style="--d:0.35s">
      {t(lang, 'Designér na pomezí UX, UI a grafiky. Začínal jsem u webu, odbočil k fyzice a nakonec se naplno vrátil k tomu, co mě baví nejvíc.', 'A designer working across UX, UI and graphic design. I started with the web, took a detour into physics and finally came back for good to what I enjoy most.')}
    </p>
  </header>

  <section class="container sekce sekce--studium">
    <p class="bg-word" aria-hidden="true" data-pismena="zespodu">{t(lang, 'Studium', 'Education')}</p>
    <div class="sloupec">
      <h2 class="subhead gradient-text" data-pismena>{t(lang, 'K designu se zastávkou u fyziky', 'To design, with a stop at physics')}</h2>
      <div class="prose">
        <p data-pismena>{t(lang, 'Moje cesta k designu nebyla úplně přímá. Začínal jsem u fotky a videí, přešel k webu, pak jsem zkusil fyziku a nakonec jsem pochopil, že mě to nejvíce táhne k tomu, dělat věci hezké a funkční a pro lidi.', 'My path to design wasn’t exactly straight. I started with photos and videos, moved on to the web, then tried physics, and in the end realised that what pulls me most is making things that are beautiful, functional and made for people.')}</p>
        <p data-pismena>{t(lang, 'Každá zastávka mi ale něco dala.', 'Every stop along the way gave me something, though.')}</p>
      </div>
    </div>
    <div class="osa-wrap"><Osa polozky={studium} /></div>
  </section>

  <section class="container sekce sekce--prace">
    <p class="bg-word bg-word--vpravo" aria-hidden="true" data-pismena="zespodu">{t(lang, 'Práce', 'Work')}</p>
    <div class="sloupec">
      <h2 class="subhead gradient-text" data-pismena>{t(lang, 'Praxe, která mě posunula.', 'Experience that moved me forward.')}</h2>
      <div class="prose">
        <p data-pismena>{t(lang, 'Vedle školy jsem prošel několik skvělých týmů, od kreativní agentury až po vývoj chytré hrazdy. Dnes pracuju hlavně na volné noze a beru projekty, které mají smysl a které mě baví.', 'Alongside my studies I’ve worked with several great teams, from a creative agency to the development of a smart pull-up bar. Today I work mostly as a freelancer and take on projects that make sense and that I enjoy.')}</p>
      </div>
    </div>
    <div class="osa-wrap"><Osa polozky={prace} /></div>
  </section>

  <section class="container sekce sekce--kam">
    <p class="bg-word" aria-hidden="true" data-pismena="zespodu">{t(lang, 'Kam dál', 'What’s next')}</p>
    <div class="sloupec">
      <h2 class="subhead gradient-text" data-pismena>{t(lang, 'Kam chci svou práci posouvat.', 'Where I want to take my work.')}</h2>
      <div class="prose">
        <p data-pismena>{t(lang, 'Design mě čím dál víc baví i jako něco, co se dá sdílet a vést. Do budoucna se chci naplno věnovat dvěma směrům.', 'More and more, I enjoy design as something to share and to lead. Going forward, I want to fully commit to two directions.')}</p>
      </div>
      <ul class="smery">
        {smery.map((s, i) => (
          <li data-reveal style={`--reveal-delay:${i * 0.1}s`}>
            <h3 class="smery__nazev">{s.nazev}</h3>
            <p class="smery__popis">{s.popis}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="container sekce sekce--mimo">
    <p class="bg-word" aria-hidden="true" data-pismena="zespodu">{t(lang, 'Mimo práci', 'Free time')}</p>
    <div class="sloupec">
      <h2 class="subhead gradient-text" data-pismena>{t(lang, 'Nejlíp je mi venku', 'I’m happiest outdoors')}</h2>
      <div class="prose">
        <p data-pismena>{t(lang, 'Když zrovna nedesignuju, jsem nejradši v přírodě. Miluju hory a sport, takže mě najdeš na kole, na běžkách nebo na discgolfovém hřišti. A když venku zrovna nejsem, sahám po kytaře nebo sedám ke klavíru.', 'When I’m not designing, I’d rather be out in nature. I love the mountains and sport, so you’ll find me on a bike, on cross-country skis or on a disc golf course. And when I’m not outside, I reach for the guitar or sit down at the piano.')}</p>
      </div>
      <a class="ig" href={site.instagramOsobni} target="_blank" rel="noopener" data-reveal>
        <Icon name="instagram" />
        <span>@tjindrak</span>
        <Icon name="arrow-up-right" class="ig__sipka" />
      </a>
    </div>
    <div class="kolaz">
      {fotky.map((f, i) => (
        <div class={`foto ${f.cls}`} data-reveal style={`--reveal-delay:${(i % 3) * 0.1}s`}>
          <Obrazek src={f.src} alt={f.alt} />
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  /* Rozměry podle Figmy (O mně, rámec 1440 px) */
  .hero {
    position: relative;
    padding-top: 169px;
  }
  .hero :global(.hero__portret) {
    position: absolute;
    left: calc(var(--gutter) + 756px);
    top: 69px;
    width: 532px;
    /* Figma: maska Rectangle 2, přechod z plné do průhledné mezi y 535 a 919 */
    -webkit-mask-image: linear-gradient(180deg, #000 32.4%, transparent 66.5%);
    mask-image: linear-gradient(180deg, #000 32.4%, transparent 66.5%);
  }
  /* Slova v pozadí jsou Nohemi SemiBold, texty Delight Regular (Figma O mně 316:447) */
  .bg-word {
    font-family: var(--font-heading);
    font-weight: 600;
  }
  .hero__nazev,
  .hero__shrnuti,
  .subhead {
    font-weight: 400;
  }
  /* Světlé nadpisy: shrnutí i podnadpisy jdou z bílé do 60 % bílé (Figma 316:447) */
  .gradient-text,
  .gradient-text--soft {
    background-image: linear-gradient(90deg, var(--fg) 0%, rgb(var(--fg-rgb) / 0.6) 100%);
  }
  .hero__slovo,
  .hero__nazev,
  .hero__shrnuti {
    position: relative;
  }
  .hero__nazev {
    margin-top: 24px;
  }
  .hero__shrnuti {
    max-width: 800px;
    font-size: clamp(22px, 2.23vw, 32px);
    margin-top: 50px;
  }
  .sekce {
    position: relative;
    margin-top: 360px;
  }
  .sekce--studium {
    margin-top: 721px;
  }
  .sekce--mimo {
    margin-top: 362px;
  }
  /* Práce sedí ve Figmě o 4 px výš, podnadpis zůstává na místě */
  .sekce--prace {
    margin-top: 356px;
  }
  .sekce--kam {
    margin-top: 364px;
  }
  .sekce .bg-word {
    font-size: clamp(88px, 15.28vw, 220px);
  }
  .bg-word--vpravo {
    text-align: right;
  }
  .bg-word--odsazene {
    padding-left: 18.37%;
  }
  .sloupec {
    position: relative;
    max-width: 820px;
  }
  .sloupec--vpravo {
    margin-left: var(--col-offset);
  }
  .sloupec--mimo {
    margin-left: 32%;
  }
  .sloupec .prose {
    margin-top: 42px;
  }
  .sekce--studium .sloupec {
    margin-top: 29px;
  }
  .sekce--studium .sloupec .prose {
    margin-top: 29px;
  }
  .sekce--prace .sloupec {
    margin-top: 28px;
  }
  .sekce--kam .sloupec {
    margin-top: 57px;
  }
  .sekce--kam .sloupec .prose {
    margin-top: 72px;
  }
  .sekce--mimo .sloupec {
    margin-top: 34px;
  }
  .osa-wrap {
    margin-top: 123px;
  }
  .sekce--prace .osa-wrap {
    margin-top: 138px;
  }
  .smery {
    display: grid;
    grid-template-columns: 380px 380px;
    gap: 60px;
    margin: 99px 0 0;
    padding: 0;
    list-style: none;
  }
  .smery__nazev {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: clamp(26px, 2.5vw, 36px);
    line-height: normal;
  }
  .smery__popis {
    margin-top: 10px;
    font-size: clamp(18px, 1.55vw, 22px);
    line-height: 1.5;
    color: var(--fg-80);
  }
  /* Soukromý Instagram pod textem Mimo práci */
  .ig {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 40px;
    font-size: clamp(20px, 1.7vw, 24px);
    color: var(--fg);
    transition: color var(--hover);
  }
  .ig :global(svg) {
    width: 28px;
    height: 28px;
    stroke-width: 1.5;
  }
  .ig :global(.ig__sipka) {
    width: 20px;
    height: 20px;
    color: var(--fg-50);
    transition: transform var(--hover), color var(--hover);
  }
  .ig:hover,
  .ig:hover :global(.ig__sipka) {
    color: var(--accent);
  }
  .ig:hover :global(.ig__sipka) {
    transform: translate(2px, -2px);
  }
  .kolaz {
    position: relative;
    aspect-ratio: 1312 / 1280;
    margin-top: 119px;
  }
  .foto {
    position: absolute;
    overflow: hidden;
    border-radius: var(--radius-media);
  }
  .f1 { left: 0; top: 0; width: 39.63%; height: 51.56%; }
  .f2 { left: 43.29%; top: 9.38%; width: 27.44%; height: 35.94%; }
  .f3 { left: 74.39%; top: 3.13%; width: 25.61%; height: 39.06%; }
  .f4 { left: 11.89%; top: 56.25%; width: 32.01%; height: 42.19%; }
  .f5 { left: 48.17%; top: 50%; width: 42.68%; height: 50%; }

  @media (max-width: 1200px) {
    .hero :global(.hero__portret) {
      left: auto;
      right: 0;
      width: 38%;
    }
    .smery {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 720px) {
    .hero {
      padding-top: 24px;
      display: flex;
      flex-direction: column;
    }
    .hero :global(.hero__portret) {
      position: relative;
      right: auto;
      top: 0;
      width: 64%;
      margin: 0 auto -40%;
    }
    .sekce,
    .sekce--studium {
      margin-top: 120px;
    }
    .sloupec,
    .sekce--studium .sloupec,
    .sekce--prace .sloupec,
    .sekce--kam .sloupec,
    .sekce--mimo .sloupec {
      margin-top: -16px;
    }
    .sloupec .prose,
    .sekce--studium .sloupec .prose,
    .sekce--kam .sloupec .prose {
      margin-top: 32px;
    }
    .sekce--prace .osa-wrap {
      margin-top: 56px;
    }
    .kolaz {
      margin-bottom: 40px;
    }
    .sloupec--mimo {
      margin-left: 0;
    }
    .bg-word--odsazene {
      padding-left: 0;
    }
    .osa-wrap {
      margin-top: 56px;
    }
    .smery {
      grid-template-columns: 1fr;
      gap: 36px;
      margin-top: 48px;
    }
    .kolaz {
      aspect-ratio: auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-top: 56px;
    }
    .foto {
      position: relative;
      left: auto;
      top: auto;
      width: auto;
      height: auto;
      aspect-ratio: 3 / 4;
    }
    .f1,
    .f5 {
      grid-column: span 2;
      aspect-ratio: 4 / 3;
    }
  }
</style>
