---
import Base from '../layouts/Base.astro';
import KontaktFormular from '../components/KontaktFormular.astro';
import { site } from '../data/site';
import { jazykZUrl, t } from '../i18n';

const lang = jazykZUrl(Astro.url);
const udaje = [
  { label: t(lang, 'E-mail', 'Email'), hodnota: site.email, href: `mailto:${site.email}` },
  { label: 'Instagram', hodnota: '@tjindrak_design', href: site.instagram, externi: true },
  { label: 'LinkedIn', hodnota: 'Tomáš Jindrák', href: site.linkedin, externi: true },
  { label: t(lang, 'Telefon', 'Phone'), hodnota: site.phone, href: `tel:${site.phone.replace(/\s/g, '')}` },
  { label: t(lang, 'IČO', 'Company ID (IČO)'), hodnota: site.ico },
];
---
<Base title={t(lang, 'Kontakt', 'Contact')} description={t(lang, 'Máš nápad nebo projekt? Napiš Tomášovi Jindrákovi.', 'Have an idea or a project? Get in touch with Tomáš Jindrák.')}>
  <header class="container hero">
    <p class="bg-word hero__slovo" aria-hidden="true" data-pismena="zespodu">{t(lang, 'Kontakt', 'Contact')}</p>
    <h1 class="title-xl hero__nazev"><span class="maska"><span style="--d:0.15s">Tomáš Jindrák</span></span></h1>
    <p class="lead gradient-text gradient-text--soft hero__shrnuti nacti" style="--d:0.3s">{t(lang, 'Máš nápad nebo projekt? Napiš mi.', 'Have an idea or a project? Drop me a line.')}</p>
  </header>

  <section class="container obsah">
    <dl class="udaje">
      {udaje.map((u, i) => (
        <div class="udaj nacti" style={`--d:${0.4 + i * 0.08}s`}>
          <dt class="label">{u.label}</dt>
          <dd>{u.href ? <a href={u.href} target={u.externi ? '_blank' : undefined} rel={u.externi ? 'noopener' : undefined}>{u.hodnota}</a> : u.hodnota}</dd>
        </div>
      ))}
    </dl>
    <KontaktFormular class="obsah__formular nacti" />
  </section>
</Base>

<style>
  .hero {
    position: relative;
    padding-top: 435px;
  }
  .hero__slovo {
    position: absolute;
    top: 209px;
    left: var(--gutter);
  }
  .hero__nazev,
  .hero__shrnuti {
    position: relative;
  }
  .hero__shrnuti {
    margin-top: 8px;
  }
  .obsah {
    display: grid;
    grid-template-columns: var(--col-offset) 1fr;
    margin-top: 72px;
  }
  .udaje {
    display: grid;
    align-content: start;
    gap: 45px;
    margin: 0;
  }
  .udaj dd {
    margin: 5px 0 0;
    font-size: clamp(22px, 2.23vw, 32px);
    font-weight: 500;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .udaj a {
    transition: color var(--hover);
  }
  .udaj a:hover {
    color: var(--accent);
  }
  @media (max-width: 900px) {
    .obsah {
      grid-template-columns: 1fr;
      gap: 72px;
    }
  }
  @media (max-width: 720px) {
    .hero {
      padding-top: 40px;
    }
    .obsah {
      margin-bottom: 40px;
    }
    .obsah {
      margin-top: 72px;
    }
  }
</style>
