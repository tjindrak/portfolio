---
// Obrázek z /public/img. Když soubor ještě neexistuje, vykreslí se
// "Zástupný obrázek" z Figmy s popiskem, takže stránka funguje i bez fotek.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Icon from './Icon.astro';
import { srcset } from '../lib/obrazky';

interface Props {
  src?: string;
  alt: string;
  class?: string;
  fit?: 'cover' | 'contain';
  position?: string;
  eager?: boolean;
  showCaption?: boolean;
  // Výřez z Figmy: "šířka výška vlevo nahoře" v % rámečku, např. "163.49 100 -34.04 0".
  // Rodič musí mít position: relative a overflow: hidden.
  vyrez?: string;
  // Šířka obrázku na stránce pro výběr varianty ze srcset. Líně načítané obrázky
  // ji v moderních prohlížečích zjistí samy (auto), jinak se počítá s celou šířkou okna.
  sizes?: string;
}

const { src, alt, class: className, fit = 'cover', position = 'center', eager = false, showCaption = true, vyrez, sizes } = Astro.props;
const exists = !!src && existsSync(join(process.cwd(), 'public', src));
const varianty = exists ? await srcset(src) : undefined;
const [w, h, l, t] = vyrez ? vyrez.split(/\s+/).map(Number) : [];
const styl = vyrez
  ? `position:absolute;width:${w}%;height:${h}%;left:${l}%;top:${t}%;max-width:none;object-fit:fill`
  : `object-fit:${fit};object-position:${position}`;
---
{exists ? (
  <img
    class:list={['obrazek', className]}
    src={src}
    srcset={varianty}
    sizes={varianty && (sizes ?? (eager ? '100vw' : 'auto, 100vw'))}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    style={styl}
  />
) : (
  <div class:list={['obrazek obrazek--placeholder', className]} role="img" aria-label={alt}>
    <span class="obrazek__inner">
      <Icon name="image" class="obrazek__icon" />
      {showCaption && <span class="obrazek__caption">{alt}</span>}
    </span>
  </div>
)}

<style>
  .obrazek {
    width: 100%;
    height: 100%;
  }
  .obrazek--placeholder {
    display: grid;
    place-items: center;
    background:
      radial-gradient(50% 50% at 50% 85%, rgb(179 174 142 / 0.16), transparent),
      linear-gradient(180deg, rgb(var(--fg-rgb) / 0.08), transparent),
      var(--tile-bg);
  }
  .obrazek__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 16px;
    text-align: center;
  }
  .obrazek__inner :global(.obrazek__icon) {
    width: 32px;
    height: 32px;
    color: var(--fg-40);
  }
  .obrazek__caption {
    font-size: 13px;
    font-weight: 500;
    color: var(--fg-40);
  }
</style>
