---
// Vyříznutý portrét z hlavní stránky (Figma: Mask group, IMG_3480).
// Soubor je už oříznutý na rámeček 592 × 1253 s průhledným pozadím,
// dole se postava ztrácí do pozadí.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { srcset } from '../lib/obrazky';

interface Props {
  class?: string;
  // Pohyblivé skleněné pruhy přes fotku (lom světla jako žebrované sklo)
  sklo?: boolean;
  // Jiný výřez fotky a jeho poměr stran (šířka / výška rámečku)
  foto?: string;
  pomer?: string;
}
const { class: className, sklo = false, foto = '/img/portret.webp', pomer = '592 / 1253' } = Astro.props;
const ready = existsSync(join(process.cwd(), 'public', foto));
const varianty = ready ? await srcset(foto) : undefined;
---
<div class:list={['portret', { 'portret--placeholder': !ready }, className]} style={`--pomer: ${pomer}`}>
  {ready ? <img src={foto} srcset={varianty} sizes={varianty && 'min(592px, 100vw)'} alt="Tomáš Jindrák" class="portret__foto" fetchpriority="high" /> : <span class="portret__silueta" role="img" aria-label="Tomáš Jindrák"></span>}
  {ready && sklo && <canvas class="portret__sklo" aria-hidden="true"></canvas>}
</div>

<script>
  // Žebrované sklo: fotka se kreslí ve WebGL a každý šikmý pruh (108 px, 21,55° jako pruhy v hero)
  // ji posune o kousek do strany. Pruhy se pomalu posouvají a lom jemně dýchá.
  // Bez WebGL nebo při omezeném pohybu zůstane obyčejná fotka.
  const VS = `attribute vec2 p; varying vec2 uv; void main(){ uv = p * 0.5 + 0.5; uv.y = 1.0 - uv.y; gl_Position = vec4(p, 0.0, 1.0); }`;
  const FS = `precision mediump float;
    varying vec2 uv;
    uniform sampler2D tex;
    uniform vec2 size;
    uniform float t;
    const vec2 dir = vec2(0.9301, 0.3673);
    const float sirka = 108.0;
    void main() {
      vec2 px = uv * size;
      float u = dot(px, dir) + t * 6.0;
      float s = fract(u / sirka);
      // lom: uvnitř pruhu se obraz posune podle polohy v pruhu, síla pomalu kolísá
      float sila = 7.0 + 2.5 * sin(t * 0.25);
      float posun = (s - 0.5) * sila;
      vec2 q = (px + dir * posun) / size;
      vec4 c = texture2D(tex, clamp(q, 0.0, 1.0));
      // jemné prosvětlení hrany pruhu
      float hrana = smoothstep(0.03, 0.0, s) + smoothstep(0.97, 1.0, s);
      c.rgb += hrana * 0.03 * c.a;
      gl_FragColor = c;
    }`;

  // Sestavení WebGL (shadery, nahrání fotky do textury) je na slabších telefonech drahé,
  // proto se spouští až po načtení stránky, po skončení intra a ve volné chvíli.
  const poNacteni = new Promise<void>((ok) =>
    document.readyState === 'complete' ? ok() : addEventListener('load', () => ok(), { once: true }),
  );
  const poIntru = new Promise<void>((ok) => {
    const root = document.documentElement;
    if (!root.classList.contains('intro-bezi')) return ok();
    const mo = new MutationObserver(() => {
      if (root.classList.contains('intro-bezi')) return;
      mo.disconnect();
      ok();
    });
    mo.observe(root, { attributes: true, attributeFilter: ['class'] });
  });
  const volno = () =>
    new Promise<void>((ok) => ('requestIdleCallback' in window ? requestIdleCallback(() => ok(), { timeout: 1500 }) : setTimeout(ok, 300)));

  Promise.all([poNacteni, poIntru]).then(volno).then(() => document.querySelectorAll<HTMLCanvasElement>('.portret__sklo').forEach((canvas) => {
    const img = canvas.parentElement?.querySelector<HTMLImageElement>('.portret__foto');
    const gl = canvas.getContext('webgl', { premultipliedAlpha: false, alpha: true });
    if (!img || !gl) return;
    const klid = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const shader = (typ: number, src: string) => {
      const sh = gl.createShader(typ)!;
      gl.shaderSource(sh, src);
      gl.compileShader(sh);
      return sh;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, shader(gl.VERTEX_SHADER, VS));
    gl.attachShader(prog, shader(gl.FRAGMENT_SHADER, FS));
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
    gl.useProgram(prog);

    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'p');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
    const uSize = gl.getUniformLocation(prog, 'size');
    const uT = gl.getUniformLocation(prog, 't');

    const start = () => {
      gl.bindTexture(gl.TEXTURE_2D, gl.createTexture());
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, img);

      let w = 0;
      let h = 0;
      const velikost = () => {
        const r = canvas.getBoundingClientRect();
        const dpr = Math.min(devicePixelRatio || 1, 2);
        w = r.width;
        h = r.height;
        canvas.width = Math.round(w * dpr);
        canvas.height = Math.round(h * dpr);
        gl.viewport(0, 0, canvas.width, canvas.height);
      };
      velikost();
      new ResizeObserver(velikost).observe(canvas);

      // Mimo okno se nekreslí vůbec, smyčka se znovu rozběhne, až se portrét vrátí
      let viditelne = true;
      let bezi = false;
      const t0 = performance.now();
      const kresli = (cas: number) => {
        bezi = false;
        if (!viditelne) return;
        gl.uniform2f(uSize, w, h);
        gl.uniform1f(uT, klid ? 0 : (cas - t0) / 1000);
        gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
        canvas.classList.add('is-ready');
        if (!klid) spust();
      };
      const spust = () => {
        if (bezi) return;
        bezi = true;
        requestAnimationFrame(kresli);
      };
      new IntersectionObserver(([e]) => {
        viditelne = e.isIntersecting;
        if (viditelne) spust();
      }).observe(canvas);
      spust();
    };
    if (img.complete && img.naturalWidth) start();
    else img.addEventListener('load', start, { once: true });
  }));
</script>

<style>
  .portret {
    position: relative;
    aspect-ratio: var(--pomer);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(180deg, #000 55%, transparent 92%);
    mask-image: linear-gradient(180deg, #000 55%, transparent 92%);
  }
  .portret__foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .portret__sklo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    /* sklo se zapíná až po intru, proto plynule přes fotku */
    transition: opacity 0.8s ease;
  }
  .portret__sklo.is-ready {
    opacity: 1;
  }
  .portret__sklo.is-ready ~ .portret__foto,
  .portret:has(.portret__sklo.is-ready) .portret__foto {
    visibility: hidden;
    transition: visibility 0s 0.8s;
  }
  .portret--placeholder {
    -webkit-mask-image: linear-gradient(180deg, #000 45%, transparent 85%);
    mask-image: linear-gradient(180deg, #000 45%, transparent 85%);
  }
  .portret__silueta {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(18% 9% at 50% 9%, rgb(var(--fg-rgb) / 0.22) 98%, transparent 100%),
      radial-gradient(45% 30% at 50% 42%, rgb(var(--fg-rgb) / 0.14) 98%, transparent 100%);
  }
</style>
