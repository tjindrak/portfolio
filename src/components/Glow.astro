---
// Měkké světelné skvrny v pozadí (Figma: Glow).
interface Props {
  variant?: 'default' | 'home';
}
const { variant = 'default' } = Astro.props;
---
<div class="glows" aria-hidden="true">
  <span class="glow glow--a"></span>
  {variant === 'home' && <span class="glow glow--b"></span>}
  <span class="glow glow--c"></span>
</div>

<style>
  .glows {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  .glow {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--glow), transparent);
    filter: blur(40px);
  }
  .glow--a {
    width: 1100px;
    height: 900px;
    left: 48%;
    top: -250px;
  }
  .glow--b {
    width: 1100px;
    height: 900px;
    left: -450px;
    top: 1500px;
    opacity: 0.7;
  }
  .glow--c {
    width: 900px;
    height: 800px;
    left: 55%;
    top: 2700px;
    opacity: 0.8;
  }
</style>
