---
// Úvodní načítání: logo uprostřed se rozsvěcuje písmeno po písmenu podle průběhu,
// dole běží procenta a nahoře linka. Pak se clona vytáhne nahoru (černá a za ní šedá)
// a prvky hero najedou: řádky nadpisu zespodu z masky, potom tlačítka, menu a fotka.
// Jen jednou za návštěvu a ne při omezeném pohybu.
import { site } from '../data/site';
const pismena = [...site.name];
---
<script is:inline>
  try {
    if (sessionStorage.getItem('intro-seen') || matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('intro-skip');
    } else {
      sessionStorage.setItem('intro-seen', '1');
      document.documentElement.classList.add('intro-bezi');
    }
  } catch {
    document.documentElement.classList.add('intro-skip');
  }
</script>
<div class="intro" aria-hidden="true">
  <span class="intro__clona intro__clona--zadni"></span>
  <span class="intro__clona intro__clona--predni">
    <span class="intro__linka"></span>
    <span class="intro__logo">{pismena.map((p) => <span>{p}</span>)}</span>
    <span class="intro__procenta">0%</span>
  </span>
</div>
<script>
  const root = document.documentElement;
  const intro = document.querySelector<HTMLElement>('.intro');

  if (intro && root.classList.contains('intro-skip')) intro.remove();
  else if (intro) {
    const pismena = [...intro.querySelectorAll<HTMLElement>('.intro__logo span')];
    const linka = intro.querySelector<HTMLElement>('.intro__linka')!;
    const procenta = intro.querySelector<HTMLElement>('.intro__procenta')!;
    const DELKA = 1700;
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const nacteno = new Promise<void>((ok) => (document.readyState === 'complete' ? ok() : addEventListener('load', () => ok(), { once: true })));
    let start = 0;

    const krok = (cas: number) => {
      start ||= cas;
      const p = ease(Math.min((cas - start) / DELKA, 1));
      linka.style.transform = `scaleX(${p})`;
      procenta.textContent = `${Math.round(p * 100)}%`;
      pismena.forEach((el, i) => el.classList.toggle('is-on', p * pismena.length > i));
      if (p < 1) requestAnimationFrame(krok);
      else nacteno.then(() => setTimeout(odhal, 250));
    };
    requestAnimationFrame(krok);

    function odhal() {
      intro!.classList.add('is-ven');
      // Hero začne najíždět ve chvíli, kdy clona odkrývá stránku
      setTimeout(() => root.classList.add('intro-odhal'), 650);
      setTimeout(() => {
        intro!.remove();
        root.classList.remove('intro-bezi', 'intro-odhal');
        dispatchEvent(new Event('intro-konec'));
      }, 3200);
    }
  }
</script>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 100;
    pointer-events: none;
  }
  :global(.intro-skip) .intro {
    display: none;
  }
  .intro__clona {
    position: absolute;
    inset: 0;
    transition: transform 0.9s cubic-bezier(0.76, 0, 0.24, 1);
  }
  .intro__clona--zadni {
    background: linear-gradient(rgb(var(--fg-rgb) / 0.06), rgb(var(--fg-rgb) / 0.06)), var(--bg);
    transition-delay: 0.42s;
  }
  .intro__clona--predni {
    display: grid;
    place-items: center;
    background: var(--bg);
    transition-delay: 0.3s;
  }
  .intro.is-ven .intro__clona {
    transform: translateY(-100%);
  }
  .intro__linka {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 2px;
    background: var(--fg);
    transform: scaleX(0);
    transform-origin: left;
  }
  .intro__logo {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 28px;
    line-height: 1;
    color: var(--fg);
  }
  .intro__logo span {
    opacity: 0.18;
    transition: opacity 0.35s ease;
  }
  .intro__logo span:global(.is-on) {
    opacity: 1;
  }
  .intro__procenta {
    position: absolute;
    left: 50%;
    bottom: 32px;
    transform: translateX(-50%);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    color: var(--fg-60, rgb(245 245 245 / 0.6));
  }
  .intro__linka,
  .intro__logo,
  .intro__procenta {
    transition: opacity 0.3s ease;
  }
  .intro.is-ven .intro__linka,
  .intro.is-ven .intro__logo,
  .intro.is-ven .intro__procenta {
    opacity: 0;
  }

  /* Najetí prvků stránky po odkrytí (výchozí stav drží třída intro-bezi) */
  :global(.intro-bezi .hero__radek > span) {
    transform: translateY(110%);
  }
  :global(.intro-bezi .hero__akce),
  :global(.intro-bezi .hero__portret) {
    opacity: 0;
    transform: translateY(32px);
  }
  :global(.intro-bezi .navbar) {
    opacity: 0;
    transform: translateY(-16px);
  }
  :global(.intro-bezi .hero__pruhy) {
    opacity: 0;
  }
  :global(.intro-odhal .hero__radek > span),
  :global(.intro-odhal .hero__akce),
  :global(.intro-odhal .hero__portret),
  :global(.intro-odhal .navbar),
  :global(.intro-odhal .hero__pruhy) {
    opacity: 1;
    transform: none;
    transition:
      transform 1.1s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.9s ease;
  }
  :global(.intro-odhal .hero__radek:nth-child(2) > span) {
    transition-delay: 0.1s;
  }
  :global(.intro-odhal .hero__portret) {
    transition-delay: 0.15s;
  }
  :global(.intro-odhal .hero__akce) {
    transition-delay: 0.35s;
  }
  :global(.intro-odhal .navbar) {
    transition-delay: 0.5s;
  }
  :global(.intro-odhal .hero__pruhy) {
    transition-delay: 0.3s;
  }
</style>
