---
// Úvodní načítání (Figma: Intro 1–3): logo uprostřed, nahoře se plní
// linka v barvě Accent a pak se vše rozplyne do hero. Jen jednou za návštěvu.
import { site } from '../data/site';
---
<script is:inline>
  try {
    if (sessionStorage.getItem('intro-seen') || matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('intro-skip');
    } else {
      sessionStorage.setItem('intro-seen', '1');
    }
  } catch {
    document.documentElement.classList.add('intro-skip');
  }
</script>
<div class="intro" aria-hidden="true">
  <span class="intro__linka"></span>
  <span class="intro__logo">{site.name}</span>
</div>
<script>
  const intro = document.querySelector<HTMLElement>('.intro');
  if (intro) {
    if (document.documentElement.classList.contains('intro-skip')) intro.remove();
    else intro.addEventListener('animationend', (e) => e.target === intro && intro.remove());
  }
</script>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    background: var(--bg);
    /* stopa načítací linky */
    background-image: linear-gradient(var(--fg-8), var(--fg-8));
    background-size: 100% 2px;
    background-repeat: no-repeat;
    animation: intro-out 0.7s ease 1.9s forwards;
  }
  :global(.intro-skip) .intro {
    display: none;
  }
  .intro__linka {
    position: absolute;
    left: 0;
    top: 0;
    height: 2px;
    width: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    animation: intro-linka 1.6s cubic-bezier(0.6, 0, 0.2, 1) 0.2s forwards;
  }
  .intro__logo {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(40px, 5vw, 72px);
    line-height: 1;
    color: var(--fg);
    opacity: 0;
    animation: intro-logo 0.6s ease 0.1s forwards;
  }
  @keyframes intro-linka {
    to {
      transform: scaleX(1);
    }
  }
  @keyframes intro-logo {
    to {
      opacity: 1;
    }
  }
  @keyframes intro-out {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }
</style>
