---
// Figma: Projekt dlaždice (240:187). Obrázek, ztmavení dole, název, typ, rok a šipka.
import Obrazek from './Obrazek.astro';
import Icon from './Icon.astro';
import { prvniExistujici, type Projekt } from '../lib/projekty';

interface Props {
  projekt: Projekt;
  siroka?: boolean;
  class?: string;
  style?: string;
  [key: `data-${string}`]: string;
}

const { projekt, siroka = false, class: className, style, ...rest } = Astro.props;
const { nazev, dlazdice, pozadi, typ, rok } = projekt.data;
const src = prvniExistujici(projekt.id, siroka ? ['sirsi.webp', 'cover.webp'] : ['cover.webp']);
---
<a href={`/projekty/${projekt.id}`} class:list={['dlazdice', { 'dlazdice--siroka': siroka }, className]} style={[style, pozadi && `background:${pozadi}`].filter(Boolean).join(';')} {...rest}>
  <Obrazek src={src} alt={nazev} class="dlazdice__img" showCaption={false} />
  <span class="dlazdice__scrim" aria-hidden="true"></span>
  <span class="dlazdice__popisek">
    <span class="dlazdice__nazev">{dlazdice ?? nazev}</span>
    <span class="dlazdice__typ">{typ}</span>
    <span class="dlazdice__rok">{rok}</span>
  </span>
  <span class="dlazdice__sipka" aria-hidden="true"><Icon name="arrow-up-right" /></span>
</a>

<style>
  .dlazdice {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius-tile);
    /* Figma: Pozadí – jemná záře zespodu a přechod z #333 do #282828 */
    background:
      radial-gradient(50% 50% at 50% 85%, rgb(179 174 142 / 0.16), transparent),
      linear-gradient(180deg, #333, rgb(40 40 40 / 0)),
      #282828;
    isolation: isolate;
  }
  .dlazdice :global(.dlazdice__img) {
    position: absolute;
    inset: 0;
    transition: transform 0.8s cubic-bezier(0.42, 0, 0.58, 1);
  }
  .dlazdice:hover :global(.dlazdice__img) {
    transform: scale(1.04);
  }
  /* Ztmavení přes celou dlaždici, bez hrany uprostřed (Figma: 0 % až do 45 %, dole 80 %) */
  .dlazdice__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(20 20 20 / 0) 45%, rgb(20 20 20 / 0.8));
  }
  .dlazdice__popisek {
    position: absolute;
    left: 24px;
    right: 84px;
    bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: var(--grayscale-0);
  }
  .dlazdice__nazev {
    font-size: 24px;
    line-height: normal;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  .dlazdice__typ,
  .dlazdice__rok {
    font-size: 14px;
    line-height: normal;
    color: rgb(245 245 245 / 0.6);
  }
  .dlazdice__rok {
    opacity: 0.6;
  }
  .dlazdice__sipka {
    position: absolute;
    right: 24px;
    bottom: 24px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--accent-5);
    color: var(--grayscale-10);
    transition: transform var(--hover), background-color var(--hover);
  }
  .dlazdice__sipka :global(svg) {
    width: 20px;
    height: 20px;
  }
  .dlazdice:hover .dlazdice__sipka {
    transform: rotate(45deg);
    background: var(--accent-3);
  }
</style>
