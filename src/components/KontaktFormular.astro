---
// Typografický formulář (Figma: Formulář, Kontakt – v2). Zprávy odesílá přes
// Web3Forms na site.email; bez klíče nebo při chybě otevře e-mail s předvyplněnou zprávou.
import { site } from '../data/site';
import { jazykZUrl, t } from '../i18n';

const lang = jazykZUrl(Astro.url);
const temata = t(lang, ['Web', 'Aplikace', 'Identita', 'UX výzkum', 'Něco jiného'], ['Website', 'App', 'Identity', 'UX research', 'Something else']);
// Hlášky pro skript (podle jazyka stránky)
const hlasky = t(
  lang,
  {
    chyba: 'Vyplň prosím jméno, e-mail a zprávu.',
    predmet: 'Poptávka z webu',
    hotovo: 'Otevírám e-mail s připravenou zprávou.',
    odesilam: 'Odesílám…',
    odeslano: 'Díky, zpráva odešla. Ozvu se co nejdřív.',
    selhalo: 'Zprávu se nepodařilo odeslat, otevírám e-mail s připravenou zprávou.',
  },
  {
    chyba: 'Please fill in your name, email and message.',
    predmet: 'Enquiry from the website',
    hotovo: 'Opening your email with the message ready.',
    odesilam: 'Sending…',
    odeslano: 'Thanks, your message is on its way. I’ll get back to you soon.',
    selhalo: 'The message couldn’t be sent, opening your email with the message ready.',
  },
);
interface Props {
  class?: string;
  // Hustší varianta na hlavní stránce (Figma: Mainpage, Frame 33)
  kompaktni?: boolean;
}
const { class: className, kompaktni = false } = Astro.props;
---
<form class:list={['formular', { 'formular--kompaktni': kompaktni }, className]} data-formular data-email={site.email} data-klic={site.web3formsKey} data-hlasky={JSON.stringify(hlasky)} novalidate>
  <fieldset class="formular__temata">
    <legend class="label">{t(lang, 'S čím ti můžu pomoct?', 'What can I help you with?')}</legend>
    <div class="formular__chips">
      {temata.map((t, i) => (
        <label class="tema">
          <input type="radio" name="tema" value={t} checked={i === 0} />
          <span>{t}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <div class="formular__radek">
    <label class="pole">
      <span class="label">{t(lang, 'Jméno', 'Name')}</span>
      <input type="text" name="jmeno" placeholder={kompaktni ? t(lang, 'Jméno Příjmení', 'First and last name') : t(lang, 'Jak ti mám říkat?', 'What should I call you?')} autocomplete="name" required />
    </label>
    <label class="pole">
      <span class="label">{t(lang, 'E-mail', 'Email')}</span>
      <input type="email" name="email" placeholder={t(lang, 'tvuj@email.cz', 'you@email.com')} autocomplete="email" required />
    </label>
  </div>

  <label class="pole pole--zprava">
    <span class="label">{t(lang, 'Zpráva', 'Message')}</span>
    <textarea name="zprava" rows="5" placeholder={t(lang, 'Napiš mi pár vět o projektu…', 'Tell me a few words about your project…')} required></textarea>
  </label>

  <!-- past na roboty (Web3Forms botcheck), lidé ji nevidí -->
  <input type="checkbox" name="botcheck" class="formular__past" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="formular__pata">
    <p class="label" data-formular-stav aria-live="polite">{t(lang, 'Údaje použiju jen k odpovědi.', 'I’ll only use your details to reply.')}</p>
    <button type="submit" class="btn btn--accent">{t(lang, 'Odeslat zprávu', 'Send message')}</button>
  </div>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-formular]').forEach((form) => {
    const stav = form.querySelector('[data-formular-stav]');
    const tlacitko = form.querySelector<HTMLButtonElement>('button[type=submit]');
    const hlasky = JSON.parse(form.dataset.hlasky ?? '{}');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        if (stav) stav.textContent = hlasky.chyba;
        form.reportValidity();
        return;
      }
      const d = new FormData(form);
      const subject = `${hlasky.predmet}: ${d.get('tema')}`;
      const otevriEmail = (hlaska: string) => {
        const body = `${d.get('zprava')}\n\n${d.get('jmeno')}\n${d.get('email')}`;
        window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        if (stav) stav.textContent = hlaska;
      };

      if (!form.dataset.klic) {
        otevriEmail(hlasky.hotovo);
        return;
      }
      if (stav) stav.textContent = hlasky.odesilam;
      if (tlacitko) tlacitko.disabled = true;
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            access_key: form.dataset.klic,
            subject,
            from_name: d.get('jmeno'),
            name: d.get('jmeno'),
            email: d.get('email'),
            tema: d.get('tema'),
            message: d.get('zprava'),
            botcheck: d.get('botcheck') ? true : '',
          }),
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || !json.success) throw new Error(json.message ?? res.statusText);
        form.reset();
        if (stav) stav.textContent = hlasky.odeslano;
      } catch {
        otevriEmail(hlasky.selhalo);
      } finally {
        if (tlacitko) tlacitko.disabled = false;
      }
    });
  });
</script>

<style>
  .formular {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }
  .formular__temata {
    margin: 0;
    padding: 0;
    border: 0;
  }
  .formular__temata legend {
    padding: 0;
    margin-bottom: 16px;
  }
  .formular__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .tema {
    position: relative;
    cursor: pointer;
  }
  .tema input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .tema span {
    display: block;
    padding: 10px 20px;
    border: 1px solid var(--fg-16);
    border-radius: 999px;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.2;
    color: var(--fg-60);
    transition: border-color var(--hover), background-color var(--hover), color var(--hover);
  }
  .tema:hover span {
    border-color: var(--fg-40);
  }
  .tema input:checked + span {
    border-color: var(--accent-5);
    background: var(--accent-alpha-16);
    color: var(--accent-soft);
  }
  .tema input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .formular__radek {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 61px;
  }
  .pole {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .pole input,
  .pole textarea {
    width: 100%;
    padding: 0 0 16px;
    border: 0;
    border-bottom: 1px solid var(--fg-24);
    border-radius: 0;
    background: none;
    font-size: 24px;
    line-height: 1.25;
    color: var(--fg);
    transition: border-color 0.2s ease;
  }
  .pole textarea {
    resize: vertical;
    min-height: 184px;
  }
  .pole input::placeholder,
  .pole textarea::placeholder {
    color: var(--fg-30);
  }
  .pole input:focus,
  .pole textarea:focus {
    outline: none;
    border-bottom-color: var(--accent);
  }
  .formular__past {
    position: absolute;
    left: -9999px;
  }
  .formular__pata {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: -8px;
    /* tlačítko je ve Figmě odsazené 28 px od pravého okraje polí */
    padding-right: 28px;
  }
  .formular__pata :global(.btn:disabled) {
    opacity: 0.5;
    cursor: progress;
  }
  .formular--kompaktni {
    gap: 48px;
  }
  .formular--kompaktni .pole--zprava {
    margin-top: -3px;
  }
  .formular--kompaktni .tema span {
    line-height: normal;
  }
  .formular--kompaktni .pole textarea {
    height: 140px;
    min-height: 140px;
  }
  .formular--kompaktni .formular__pata {
    padding-right: 0;
  }
  /* Hlavní stránka (Figma Mainpage): popisky, štítky i tlačítko v řezu Regular */
  .formular--kompaktni .label,
  .formular--kompaktni .tema span,
  .formular--kompaktni .formular__pata :global(.btn) {
    font-weight: 400;
  }
  .formular--kompaktni .label {
    line-height: normal;
  }
  /* Na hlavní stránce je otázka nad štítky jen pro čtečky, místo po ní zůstává (Figma) */
  .formular--kompaktni .formular__temata {
    position: relative;
    padding-top: 32px;
  }
  .formular--kompaktni .formular__temata legend {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .formular--kompaktni .pole {
    gap: 17px;
  }
  .formular--kompaktni .formular__radek {
    grid-template-columns: 1fr;
    gap: 43px;
  }
  .formular--kompaktni .pole input,
  .formular--kompaktni .pole textarea {
    padding-bottom: 18px;
  }
  @media (max-width: 720px) {
    .formular,
    .formular--kompaktni {
      gap: 40px;
    }
    .formular--kompaktni .pole--zprava {
      margin-top: 0;
    }
    .formular__radek {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .pole input,
    .pole textarea {
      font-size: 20px;
    }
    .formular__pata {
      flex-direction: column-reverse;
      align-items: stretch;
    }
  }
</style>
