---
import { nav, site } from '../data/site';
import Icon from './Icon.astro';
import { jazykZUrl, odkaz, prelozitCestu, t } from '../i18n';

const lang = jazykZUrl(Astro.url);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
const polozky = nav.map((n) => ({ href: odkaz(lang, n.stranka), label: n.label[lang] }));
const cz = prelozitCestu(path, 'cs');
const en = prelozitCestu(path, 'en');
---
<header class="navbar container">
  <a href={odkaz(lang, 'domu')} class="navbar__logo" aria-label={`${site.name}, ${t(lang, 'úvodní stránka', 'home page')}`}>{site.name}</a>

  <nav class="navbar__nav" aria-label={t(lang, 'Hlavní navigace', 'Main navigation')}>
    <ul class="navbar__links">
      {polozky.map((item) => (
        <li>
          <a href={item.href} class:list={['navbar__link', { 'is-active': isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    <span class="navbar__divider" aria-hidden="true"></span>
    <div class="navbar__tools">
      <span class="navbar__lang">
        <a href={cz} hreflang="cs" lang="cs" class:list={{ 'navbar__lang-active': lang === 'cs' }} aria-current={lang === 'cs' ? 'true' : undefined} aria-label="Česky">CZ</a>
        <span aria-hidden="true">/</span>
        <a href={en} hreflang="en" lang="en" class:list={{ 'navbar__lang-active': lang === 'en' }} aria-current={lang === 'en' ? 'true' : undefined} aria-label="English">EN</a>
      </span>
      <button type="button" class="navbar__theme" data-theme-toggle aria-label={t(lang, 'Přepnout světlý a tmavý motiv', 'Switch light and dark theme')}>
        <Icon name="moon" class="icon-moon" />
        <Icon name="sun" class="icon-sun" />
      </button>
    </div>
  </nav>

  <button type="button" class="navbar__burger" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
    <span class="sr-only">Menu</span>
    <span class="navbar__burger-line"></span>
    <span class="navbar__burger-line"></span>
  </button>
</header>

<div class="mobile-menu" id="mobile-menu" hidden>
  <ul>
    {polozky.map((item) => (
      <li>
        <a href={item.href} class:list={{ 'is-active': isActive(item.href) }}>{item.label}</a>
      </li>
    ))}
  </ul>
  <p class="mobile-menu__lang">
    <a href={cz} hreflang="cs" lang="cs" class:list={{ 'is-active': lang === 'cs' }}>CZ</a>
    <span aria-hidden="true">/</span>
    <a href={en} hreflang="en" lang="en" class:list={{ 'is-active': lang === 'en' }}>EN</a>
  </p>
  <button type="button" class="mobile-menu__theme" data-theme-toggle>{t(lang, 'Přepnout motiv', 'Switch theme')}</button>
</div>

<script>
  const root = document.documentElement;
  document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      const prepni = () => {
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      };
      // Nový motiv se rozlije kruhem od tlačítka (View Transitions); jinde se jen přepne
      if (!document.startViewTransition || matchMedia('(prefers-reduced-motion: reduce)').matches) return prepni();
      const r = btn.getBoundingClientRect();
      const x = e.clientX || r.left + r.width / 2;
      const y = e.clientY || r.top + r.height / 2;
      const polomer = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
      root.classList.add('motiv-prepina');
      const prechod = document.startViewTransition(prepni);
      prechod.ready.then(() => {
        root.animate(
          { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${polomer}px at ${x}px ${y}px)`] },
          { duration: 700, easing: 'cubic-bezier(0.42, 0, 0.58, 1)', pseudoElement: '::view-transition-new(root)' },
        );
      });
      prechod.finished.finally(() => root.classList.remove('motiv-prepina'));
    });
  });

  const burger = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');
  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') !== 'true';
    burger.setAttribute('aria-expanded', String(open));
    if (menu) menu.hidden = !open;
    document.body.classList.toggle('menu-open', open);
  });
</script>

<style>
  .navbar {
    position: relative;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 77px;
    margin-top: 24px;
  }
  .navbar__logo {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 28px;
    line-height: 1;
    color: var(--fg);
  }
  .navbar__nav {
    display: flex;
    align-items: center;
    gap: 48px;
  }
  .navbar__links {
    display: flex;
    gap: 36px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .navbar__link {
    position: relative;
    display: block;
    font-size: 17px;
    color: var(--fg-70);
    transition: color var(--hover);
  }
  .navbar__link:hover {
    color: var(--fg);
  }
  .navbar__link.is-active {
    color: var(--accent);
  }
  .navbar__divider {
    width: 1px;
    height: 20px;
    background: var(--fg-8);
  }
  .navbar__tools {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .navbar__lang {
    display: flex;
    gap: 6px;
    font-size: 14px;
    color: var(--fg-60);
  }
  .navbar__lang a {
    transition: color var(--hover);
  }
  .navbar__lang a:hover {
    color: var(--fg);
  }
  .navbar__lang .navbar__lang-active,
  .navbar__lang .navbar__lang-active:hover {
    font-weight: 500;
    color: var(--accent);
  }
  .navbar__theme {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin: -7px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--fg);
    cursor: pointer;
  }
  /* Ikony vykresluje komponenta Icon, proto :global */
  .navbar__theme :global(svg) {
    width: 18px;
    height: 18px;
  }
  .navbar__theme :global(.icon-sun) {
    display: none;
  }
  :global(:root[data-theme='light']) .navbar__theme :global(.icon-sun) {
    display: block;
  }
  :global(:root[data-theme='light']) .navbar__theme :global(.icon-moon) {
    display: none;
  }
  .navbar__burger {
    display: none;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    position: relative;
  }
  .navbar__burger-line {
    position: absolute;
    left: 11px;
    width: 22px;
    height: 2px;
    background: var(--fg);
    transition: transform 0.25s ease;
  }
  .navbar__burger-line:nth-of-type(2) {
    top: 17px;
  }
  .navbar__burger-line:last-of-type {
    top: 25px;
  }
  .navbar__burger[aria-expanded='true'] .navbar__burger-line:nth-of-type(2) {
    transform: translateY(4px) rotate(45deg);
  }
  .navbar__burger[aria-expanded='true'] .navbar__burger-line:last-of-type {
    transform: translateY(-4px) rotate(-45deg);
  }
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 15;
    padding: 140px var(--gutter) 40px;
    background: var(--bg);
  }
  .mobile-menu ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mobile-menu a {
    display: block;
    padding: 10px 0;
    font-family: var(--font-heading);
    font-size: 40px;
    color: var(--fg-70);
  }
  .mobile-menu a.is-active {
    color: var(--accent);
  }
  .mobile-menu__lang {
    display: flex;
    gap: 8px;
    margin-top: 32px;
    font-size: 16px;
    color: var(--fg-60);
  }
  .mobile-menu .mobile-menu__lang a {
    display: inline;
    padding: 0;
    font-family: inherit;
    font-size: inherit;
    color: var(--fg-60);
  }
  .mobile-menu .mobile-menu__lang a.is-active {
    color: var(--accent);
  }
  .mobile-menu__theme {
    margin-top: 24px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--fg-60);
    cursor: pointer;
  }
  @media (max-width: 900px) {
    .navbar {
      height: 56px;
      margin-top: 16px;
    }
    .navbar__nav {
      display: none;
    }
    .navbar__burger {
      display: block;
    }
  }
</style>
