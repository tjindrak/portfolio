---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Glow from '../components/Glow.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  glow?: 'default' | 'home' | 'brzy';
  // Barva spodních skvrn v pozadí (detail hotového projektu)
  glowBarva?: string;
}

const { title, description = site.description, glow = 'default', glowBarva } = Astro.props;
const fullTitle = title ? `${title} · ${site.fullName}` : `${site.fullName} · Grafický a UI/UX designer`;
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#141414" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/Delight-VF.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/Nohemi-Medium.otf" as="font" type="font/otf" crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <slot name="head" />
  </head>
  <body id="top">
    <slot name="before" />
    <div class="page">
      <Glow variant={glow} barva={glowBarva} />
      <Navbar />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
    <style>
      .page {
        position: relative;
        min-height: 100vh;
        overflow: hidden;
      }
      main {
        position: relative;
        z-index: 1;
      }
    </style>
  </body>
</html>
