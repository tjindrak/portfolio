---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Glow from '../components/Glow.astro';
import { site } from '../data/site';
import { jazykZUrl, prelozitCestu, t } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  glow?: 'default' | 'home' | 'brzy';
  // Barva spodních skvrn v pozadí (detail hotového projektu)
  glowBarva?: string;
}

const lang = jazykZUrl(Astro.url);
const { title, description = site.description[lang], glow = 'default', glowBarva } = Astro.props;
const fullTitle = title ? `${title} · ${site.fullName}` : `${site.fullName} · ${t(lang, 'Grafický a UI/UX designer', 'Graphic and UI/UX designer')}`;
const cesta = Astro.url.pathname.replace(/\/$/, '') || '/';
const adresa = (c: string) => new URL(c, Astro.site).href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={t(lang, 'cs_CZ', 'en_US')} />
    <meta name="theme-color" content="#141414" />
    <link rel="alternate" hreflang="cs" href={adresa(prelozitCestu(cesta, 'cs'))} />
    <link rel="alternate" hreflang="en" href={adresa(prelozitCestu(cesta, 'en'))} />
    <link rel="alternate" hreflang="x-default" href={adresa(prelozitCestu(cesta, 'cs'))} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/Delight-VF.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/Nohemi-Medium.otf" as="font" type="font/otf" crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <slot name="head" />
  </head>
  <body id="top">
    <slot name="before" />
    <div class="page">
      <Glow variant={glow} barva={glowBarva} />
      <Navbar />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    <script>
      const klid = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
      );
      // data-reveal="pozde": objeví se až když je prvek z velké části v okně
      const ioPozde = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              ioPozde.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.4 },
      );
      document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) =>
        (el.dataset.reveal === 'pozde' ? ioPozde : io).observe(el),
      );

      // Mobil: velká slova v pozadí se zmenší tak, aby nepřetékala přes okraj
      const slova = [...document.querySelectorAll<HTMLElement>('.bg-word')];
      const vejitSlova = () =>
        slova.forEach((el) => {
          el.style.fontSize = '';
          if (innerWidth > 720 || !el.clientWidth) return;
          const sirka = el.scrollWidth;
          if (sirka > el.clientWidth) {
            el.style.fontSize = `${Math.floor((parseFloat(getComputedStyle(el).fontSize) * el.clientWidth) / sirka)}px`;
          }
        });
      let cekaniSlova = 0;
      addEventListener('resize', () => {
        clearTimeout(cekaniSlova);
        cekaniSlova = window.setTimeout(vejitSlova, 150);
      });

      // Texty najíždějí písmeno po písmenu zleva doprava, když se dostanou do okna.
      // Slova zůstávají celá (kvůli zalamování), čtečky dostanou celý text přes aria-label.
      if (!klid) {
        const pozorovatel = new IntersectionObserver(
          (zaznamy) =>
            zaznamy.forEach((z) => {
              if (!z.isIntersecting) return;
              z.target.classList.add('is-in');
              pozorovatel.unobserve(z.target);
            }),
          { rootMargin: '0px 0px -12% 0px' }
        );
        const prechody: HTMLElement[] = [];
        document.querySelectorAll<HTMLElement>('[data-pismena]').forEach((el) => {
          const text = (el.textContent ?? '').replace(/[ \t\n\r]+/g, ' ').trim();
          el.setAttribute('aria-label', text);
          el.textContent = '';
          let i = 0;
          text.split(' ').forEach((slovo, n) => {
            if (n) el.append(' ');
            const s = document.createElement('span');
            s.className = 'slovo';
            s.setAttribute('aria-hidden', 'true');
            for (const znak of slovo) {
              const z = document.createElement('span');
              z.className = 'pismeno';
              z.textContent = znak;
              z.style.setProperty('--i', String(i++));
              s.append(z);
            }
            el.append(s);
          });
          el.style.setProperty('--n', String(i));
          el.classList.add('pismena');
          if (el.dataset.pismena === 'zespodu') el.classList.add('pismena--zespodu');
          // Přechodová barva (background-clip: text) se kreslí na rodiči, takže by
          // písmena nemizela. Každé písmeno proto dostane svůj výřez z přechodu.
          if (getComputedStyle(el).backgroundClip === 'text') {
            el.classList.add('pismena--prechod');
            prechody.push(el);
          }
          pozorovatel.observe(el);
        });
        const umistit = () =>
          prechody.forEach((el) => {
            const r = el.getBoundingClientRect();
            el.style.setProperty('--pw', `${r.width}px`);
            el.style.setProperty('--ph', `${r.height}px`);
            el.querySelectorAll<HTMLElement>('.pismeno').forEach((z) => {
              const p = z.getBoundingClientRect();
              z.style.backgroundPosition = `${r.left - p.left}px ${r.top - p.top}px`;
            });
          });
        umistit();
        document.fonts?.ready.then(umistit);
        let cekani = 0;
        addEventListener('resize', () => {
          clearTimeout(cekani);
          cekani = window.setTimeout(umistit, 150);
        });
      }
      vejitSlova();
      document.fonts?.ready.then(vejitSlova);
    </script>
    <style>
      .page {
        position: relative;
        min-height: 100vh;
        overflow: hidden;
      }
      main {
        position: relative;
        z-index: 1;
      }
    </style>
  </body>
</html>
