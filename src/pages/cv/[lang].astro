---
// Tisková podoba životopisu (A4). Z ní `npm run cv` vyrobí public/cv.pdf a public/cv-en.pdf.
// Stránka není v menu a nemá se indexovat.
import type { GetStaticPaths } from 'astro';
import '../../styles/global.css';
import { site } from '../../data/site';
import { zivotopis } from '../../data/zivotopis';
import { odkaz, t, type Lang } from '../../i18n';

export const getStaticPaths = (() => [{ params: { lang: 'cs' } }, { params: { lang: 'en' } }]) satisfies GetStaticPaths;

const lang = Astro.params.lang as Lang;
const { vzdelani, klienti, vsichniKlienti, prezentace, dovednosti, software, jazyky } = zivotopis(lang);
const web = new URL(odkaz(lang, 'domu'), Astro.site);
const webText = web.host + (web.pathname === '/' ? '' : web.pathname);
const kontakty = [
  { text: site.email, href: `mailto:${site.email}` },
  { text: site.phone, href: `tel:${site.phone.replace(/\s/g, '')}` },
  { text: webText, href: web.href },
  { text: '@tjindrak_design', href: site.instagram },
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{t(lang, 'Životopis', 'CV')} · {site.fullName}</title>
  </head>
  <body>
    <main class="list">
      <header class="hlava">
        <div>
          <h1 class="jmeno">{site.fullName}</h1>
          <p class="role">UX/UI designer</p>
          <p class="misto">{t(lang, 'Praha / Rychnov u Jablonce nad Nisou', 'Prague / Rychnov u Jablonce nad Nisou, Czech Republic')}</p>
        </div>
        <img class="foto" src="/img/zivotopis/portret.webp" alt="" />
      </header>

      <ul class="kontakty">
        {kontakty.map((k) => <li><a href={k.href}>{k.text}</a></li>)}
      </ul>

      <p class="profil">
        {t(
          lang,
          'Jsem designer, který se nejdřív ptá a teprve potom tvoří. Navrhuju digitální produkty od prvního rozhovoru s uživateli až po finální pixel a pomáhám týmům a značkám proměnit to, co lidé opravdu potřebují, v rozhraní, která se dobře používají a hezky vypadají.',
          'I’m a designer who asks questions first and designs second. I design digital products from the first user interview to the final pixel, and help teams and brands turn what people really need into interfaces that are easy to use and look good.',
        )}
      </p>

      <div class="sloupce">
        <div class="sloupec">
          <section>
            <h2>{t(lang, 'Pracovní zkušenosti', 'Work experience')}</h2>
            <ul class="klienti">
              {klienti.map((k) => (
                <li class="klient">
                  <img class:list={['logo', { 'logo--siroke': k.siroke }]} src={k.logo} alt="" />
                  <div>
                    <p class="hlavicka"><span class="nazev">{k.nazev}</span><span class="rok">{k.rok}</span></p>
                    <p class="popis">{k.popis}</p>
                  </div>
                </li>
              ))}
            </ul>
          </section>

          <section>
            <h2>{t(lang, 'Moji klienti', 'My clients')}</h2>
            <p class="popis odstavec">{vsichniKlienti.join(', ')}</p>
          </section>
        </div>

        <div class="sloupec">
          <section>
            <h2>{t(lang, 'Vzdělání', 'Education')}</h2>
            <ul class="seznam">
              {vzdelani.map((v) => (
                <li>
                  <p class="nazev">{v.skola}</p>
                  <p class="rok">{v.roky}</p>
                  <p class="popis">{v.obor}, {v.titul}</p>
                </li>
              ))}
            </ul>
          </section>

          <section>
            <h2>{t(lang, 'Jazyky', 'Languages')}</h2>
            <ul class="seznam seznam--tesny">
              {jazyky.map((j) => (
                <li class="jazyk">
                  <span class="nazev">{j.nazev}</span>
                  <span class="popis">{j.popis.replace(/\.$/, '')}</span>
                </li>
              ))}
            </ul>
          </section>

          <section>
            <h2>{t(lang, 'Prezentace projektů', 'Project presentations')}</h2>
            <p class="popis odstavec">{prezentace}</p>
          </section>
        </div>
      </div>

      <footer class="pata">
        <span>{site.fullName}</span>
        <a href={web.href}>{webText}</a>
      </footer>
    </main>

    <main class="list">
      <section>
        <h2>{t(lang, 'Dovednosti', 'Skills')}</h2>
        <ul class="dovednosti">
          {dovednosti.map((d) => (
            <li>
              <p class="nazev">{d.nazev}</p>
              <p class="popis">{d.popis}</p>
            </li>
          ))}
        </ul>
      </section>

      <section class="software-blok">
        <h2>Software</h2>
        <ul class="software">
          {software.map((s) => (
            <li><img src={`/img/zivotopis/software/${s.soubor}.svg`} alt={s.nazev} title={s.nazev} /></li>
          ))}
        </ul>
      </section>

      <footer class="pata">
        <span>{site.fullName}</span>
        <a href={web.href}>{webText}</a>
      </footer>
    </main>
  </body>
</html>

<style is:global>
  /* Světlá tisková verze webu: Ink Charcoal na bílé, všechno v Delightu, bez podtržení a barevných nadpisů */
  @page {
    size: A4;
    margin: 0;
  }
  :root {
    --ink: 20 20 20;
  }
  html,
  body {
    margin: 0;
    background: #fff;
    color: rgb(var(--ink));
    font-family: 'Delight', sans-serif;
    font-weight: 400;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .list {
    box-sizing: border-box;
    width: 210mm;
    height: 297mm;
    padding: 18mm 18mm 12mm;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    break-after: page;
  }
  .list:last-of-type {
    break-after: auto;
  }
  .list p,
  .list h1,
  .list h2,
  .list ul {
    margin: 0;
    padding: 0;
  }
  .list ul {
    list-style: none;
  }
  .list a {
    color: inherit;
    text-decoration: none;
  }
  .hlava {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10mm;
  }
  .jmeno {
    font-weight: 400;
    font-size: 30pt;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .role {
    margin-top: 2.5mm !important;
    font-size: 14pt;
    line-height: 1.3;
    color: rgb(var(--ink) / 0.6);
  }
  .misto {
    margin-top: 1.5mm !important;
    font-size: 9pt;
    color: rgb(var(--ink) / 0.5);
  }
  .foto {
    width: 28mm;
    height: 28mm;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 18%;
    background: #efefed;
  }
  .kontakty {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5mm 9mm;
    margin-top: 8mm !important;
    font-size: 9pt;
    color: rgb(var(--ink) / 0.75);
  }
  .profil {
    max-width: 150mm;
    margin-top: 8mm !important;
    font-size: 10.5pt;
    line-height: 1.6;
    color: rgb(var(--ink) / 0.8);
  }
  h2 {
    margin-bottom: 5mm !important;
    font-weight: 400;
    font-size: 13pt;
    line-height: 1.2;
    color: rgb(var(--ink) / 0.45);
  }
  .sloupce {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 14mm;
    margin-top: 12mm;
  }
  .sloupec {
    display: flex;
    flex-direction: column;
    gap: 10mm;
  }
  .nazev {
    font-size: 10pt;
    line-height: 1.35;
  }
  .rok {
    margin-top: 0.4mm !important;
    font-size: 8.5pt;
    color: rgb(var(--ink) / 0.45);
    font-variant-numeric: tabular-nums;
  }
  .popis {
    margin-top: 1mm !important;
    font-size: 8.75pt;
    line-height: 1.45;
    color: rgb(var(--ink) / 0.68);
  }
  .rok + .popis {
    margin-top: 1.2mm !important;
  }
  .popis + .popis {
    margin-top: 0 !important;
  }
  .klienti {
    display: flex;
    flex-direction: column;
    gap: 6mm;
  }
  .klient {
    display: grid;
    grid-template-columns: 10mm 1fr;
    gap: 4mm;
    align-items: start;
  }
  .hlavicka {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 4mm;
    max-width: 70mm;
  }
  .klient .popis {
    max-width: 62mm;
  }
  .logo {
    width: 10mm;
    height: 10mm;
    object-fit: contain;
    border-radius: 2.5mm;
    background: #f3f3f1;
  }
  .logo--siroke {
    box-sizing: border-box;
    background: #fff;
    border: 0.75pt solid rgb(var(--ink) / 0.08);
  }
  .odstavec {
    margin: 0 !important;
    font-size: 9pt;
    line-height: 1.55;
  }
  .seznam {
    display: flex;
    flex-direction: column;
    gap: 5.5mm;
  }
  .seznam--tesny {
    gap: 1.5mm;
  }
  .jazyk {
    display: grid;
    grid-template-columns: 22mm 1fr;
    align-items: baseline;
  }
  .jazyk .popis {
    margin: 0 !important;
  }
  .software {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5mm;
  }
  .software img {
    display: block;
    width: 9mm;
    height: 9mm;
  }
  .dovednosti {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 9mm 14mm;
  }
  .dovednosti .nazev {
    font-size: 11pt;
  }
  .dovednosti .popis {
    margin-top: 1.5mm !important;
    font-size: 9.5pt;
    line-height: 1.55;
  }
  .software-blok {
    margin-top: 14mm;
  }
  .pata {
    display: flex;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 5mm;
    font-size: 8.5pt;
    color: rgb(var(--ink) / 0.5);
  }
  @media screen {
    body {
      background: #e9e9e6;
      padding: 24px 0;
    }
    .list {
      margin: 0 auto 24px;
      background: #fff;
      box-shadow: 0 10px 40px rgb(0 0 0 / 0.12);
    }
  }
</style>
