---
import Base from '../layouts/Base.astro';
import Obrazek from '../components/Obrazek.astro';
import Icon from '../components/Icon.astro';

// CV ke stažení: nahraj PDF do public/cv.pdf.
const CV = '/cv.pdf';

const vzdelani = [
  { logo: '/img/zivotopis/logo-vse.webp', skola: 'VŠE, Fakulta informatiky a statistiky', obor: 'UX výzkum a design', titul: 'Ing.', roky: '2025 – dnes' },
  { logo: '/img/zivotopis/logo-vskk.webp', skola: 'Vysoká škola kreativní komunikace', obor: 'Grafický a mediální design', titul: 'BcA.', roky: '2022 – 2025' },
  { logo: '/img/zivotopis/logo-spsse.webp', skola: 'SPŠSE a VOŠ Liberec', obor: 'Technické lyceum, multimédia a web design', titul: 'Maturita', roky: '2018 – 2022' },
];
const klienti = [
  { logo: '/img/zivotopis/logo-jardova-mapa.webp', nazev: 'Jarda Havelka', rok: '2026', popis: 'Redesign webové aplikace s mapou a plánovačem výletů do hor' },
  { logo: '/img/zivotopis/logo-czechitacademy.webp', siroke: true, nazev: 'Czech IT Academy', rok: '2025 – 2026', popis: 'Brand, aplikace, web a tisk pro chytrou hrazdu Pull Up Star' },
  { logo: '/img/zivotopis/logo-laba.webp', nazev: 'Laba', rok: '2024', popis: 'Social media specialist, content creator' },
  { logo: '/img/zivotopis/logo-dike.svg', nazev: 'DIKÉ', rok: '2025', popis: 'Řízení projektu rebrandingu a redesignu webových stránek' },
  { logo: '/img/zivotopis/logo-kreativni-kancl.webp', nazev: 'Kreativní kancl', rok: '2024', popis: 'Tvorba obsahu pro sociální sítě' },
];
const dalsiKlienti = ['Český tenisový svaz', 'Tolion Health', 'EnMass', 'Fox&Fellows', 'Zoo Zlín'];
// Loga dalších klientů ve stejném pořadí jako ve Figmě
const dalsiLoga = ['logo-dalsi-1.webp', 'logo-dalsi-2.webp', 'logo-dalsi-3.webp', 'logo-dalsi-4.svg', 'logo-dalsi-5.webp'];
const dovednosti = [
  { nazev: 'UX výzkum a design', popis: 'Zjišťuju, co lidé opravdu potřebují. Rozhovory, testování a z nich jasná struktura produktu.' },
  { nazev: 'UI design', popis: 'Navrhuju rozhraní pro web, mobil i aplikace. Čistá, přehledná a připravená rovnou do vývoje.' },
  { nazev: 'Vizuální identita a grafika', popis: 'Od loga přes barvy a písmo až po tisk. Brand, který drží pohromadě na webu i v ruce.' },
];
const jazyky = [
  { nazev: 'Čeština', popis: 'Rodilý mluvčí.' },
  { nazev: 'Angličtina', popis: 'Vysoká komunikační úroveň' },
];
---
<Base title="Životopis" description="Životopis Tomáše Jindráka: vzdělání, klienti, dovednosti a jazyky.">
  <!-- Rozměry podle Figmy (Životopis, rámec 1440 px) -->
  <header class="container hero">
    <p class="bg-word hero__slovo" aria-hidden="true">Životopis</p>
    <div class="hero__radek">
      <div class="hero__foto"><Obrazek src="/img/zivotopis/portret.webp" alt="Tomáš Jindrák" showCaption={false} eager /></div>
      <div class="hero__text">
        <h1 class="title-xl">Tomáš Jindrák</h1>
        <p class="lead gradient-text gradient-text--soft hero__role">UX/UI designer</p>
        <p class="hero__misto">Praha / Liberec&nbsp;&nbsp;·&nbsp;&nbsp;CZ / EN</p>
      </div>
      <a class="btn btn--accent hero__cv" href={CV} download>Stáhnout CV<Icon name="download" /></a>
    </div>
  </header>

  <section class="container blok blok--vzdelani">
    <h2 class="blok__nadpis">Vzdělání</h2>
    <ul class="blok__obsah vzdelani">
      {vzdelani.map((v, i) => (
        <li class="skola" data-reveal style={`--reveal-delay:${i * 0.08}s`}>
          <div class="logo logo--64"><Obrazek src={v.logo} alt={v.skola} showCaption={false} fit="contain" /></div>
          <div>
            <h3 class="skola__nazev">{v.skola}</h3>
            <p class="skola__popis">{v.obor} · {v.titul}</p>
          </div>
          <p class="rok skola__rok">{v.roky}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="container blok">
    <h2 class="blok__nadpis">Klienti</h2>
    <ul class="blok__obsah mrizka klienti">
      {klienti.map((k, i) => (
        <li class="klient" data-reveal style={`--reveal-delay:${(i % 2) * 0.08}s`}>
          <div class:list={['logo logo--56', { 'logo--siroke': k.siroke }]}><Obrazek src={k.logo} alt={k.nazev} showCaption={false} fit={k.siroke ? 'cover' : 'contain'} /></div>
          <h3 class="klient__nazev">{k.nazev}</h3>
          <p class="rok klient__rok">{k.rok}</p>
          <p class="klient__popis">{k.popis}</p>
        </li>
      ))}
      <li class="klient" data-reveal style="--reveal-delay:0.08s">
        <div class="loga-dalsi">
          {dalsiKlienti.map((n, i) => (
            <div class="logo logo--56"><Obrazek src={`/img/zivotopis/${dalsiLoga[i]}`} alt={n} showCaption={false} fit="contain" /></div>
          ))}
        </div>
        <h3 class="klient__nazev">Další klienti</h3>
        <p class="klient__popis klient__popis--bez-roku">{dalsiKlienti.join(', ')}</p>
      </li>
    </ul>
  </section>

  <section class="container blok blok--dovednosti">
    <h2 class="blok__nadpis">Dovednosti</h2>
    <ul class="blok__obsah dovednosti">
      {dovednosti.map((d, i) => (
        <li data-reveal style={`--reveal-delay:${i * 0.08}s`}>
          <h3 class="dovednost__nazev">{d.nazev}</h3>
          <p class="dovednost__popis">{d.popis}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="container blok">
    <h2 class="blok__nadpis">Jazyky</h2>
    <ul class="blok__obsah mrizka">
      {jazyky.map((j) => (
        <li data-reveal>
          <h3 class="dovednost__nazev">{j.nazev}</h3>
          <p class="dovednost__popis">{j.popis}</p>
        </li>
      ))}
    </ul>
  </section>

  <div class="container zaver">
    <a class="btn btn--accent" href={CV} download>Stáhnout CV<Icon name="download" /></a>
  </div>
</Base>

<style>
  .hero {
    position: relative;
    padding-top: 209px;
  }
  .hero__slovo {
    position: absolute;
    top: 209px;
    left: var(--gutter);
  }
  .hero__radek {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 40px;
    padding-top: 150px;
  }
  .hero__foto {
    flex: none;
    width: 168px;
    height: 168px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--fg-8);
  }
  .hero__foto :global(.obrazek) {
    width: 100%;
    height: 100%;
    filter: grayscale(1);
  }
  .hero__text {
    flex: 1;
    /* text začíná 24 px pod slovem Životopis */
    margin-top: 76px;
  }
  .hero__role {
    margin-top: 8px;
  }
  .hero__misto {
    margin-top: 26px;
    font-size: 17px;
    font-weight: 500;
    color: var(--fg-40);
  }
  .hero__cv {
    margin-top: 96px;
  }
  .blok {
    display: grid;
    grid-template-columns: var(--col-offset) 1fr;
    margin-top: 360px;
  }
  .blok--vzdelani {
    margin-top: 359px;
  }
  .blok--dovednosti {
    margin-top: 327px;
  }
  .blok__nadpis {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: clamp(40px, 5vw, 72px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--fg-30);
  }
  .blok__obsah {
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
  }
  .vzdelani {
    display: grid;
    gap: 56px;
  }
  .skola {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    align-items: start;
    gap: 24px;
  }
  .skola__nazev {
    margin-top: 2px;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: clamp(22px, 1.8vw, 26px);
    line-height: 1.2;
  }
  .skola__popis {
    margin-top: 7px;
    font-size: clamp(18px, 1.4vw, 20px);
    line-height: 1.5;
    color: var(--fg-80);
  }
  .rok {
    font-size: 15px;
    font-weight: 500;
    color: var(--fg-40);
    white-space: nowrap;
  }
  .skola__rok {
    margin-top: 8px;
    font-size: 17px;
    text-align: right;
  }
  .mrizka {
    display: grid;
    grid-template-columns: minmax(0, 380px) minmax(0, 380px);
    column-gap: 60px;
  }
  .klienti {
    row-gap: 63px;
  }
  .logo {
    overflow: hidden;
    background: var(--fg-8);
  }
  .logo :global(.obrazek) {
    width: 100%;
    height: 100%;
  }
  .logo :global(.obrazek__icon) {
    width: 40%;
    height: 40%;
  }
  .logo--64 {
    width: 64px;
    height: 64px;
    border-radius: 18px;
  }
  .logo--56 {
    width: 56px;
    height: 56px;
    border-radius: 16px;
  }
  .logo--siroke {
    width: 122px;
  }
  .loga-dalsi {
    display: flex;
    gap: 16px;
  }
  .klient__nazev {
    margin-top: 20px;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 24px;
    line-height: 1.2;
  }
  .klient__rok {
    margin-top: 4px;
  }
  .klient__popis {
    margin-top: 6px;
    font-size: 18px;
    line-height: 1.5;
    color: var(--fg-80);
  }
  .klient__popis--bez-roku {
    margin-top: 32px;
  }
  .dovednosti {
    display: grid;
    gap: 57px;
  }
  .dovednost__nazev {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 28px;
    line-height: 1.2;
  }
  .dovednost__popis {
    margin-top: 10px;
    font-size: clamp(18px, 1.55vw, 22px);
    line-height: 1.5;
    color: var(--fg-80);
  }
  .zaver {
    display: flex;
    justify-content: center;
    margin-top: 160px;
  }

  @media (max-width: 1100px) {
    .hero__radek {
      flex-wrap: wrap;
    }
    .hero__text,
    .hero__cv {
      margin-top: 0;
    }
    .blok {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
  @media (max-width: 720px) {
    .hero,
    .hero__slovo {
      padding-top: 40px;
      top: 0;
    }
    .hero__radek {
      flex-direction: column;
      gap: 24px;
      padding-top: 64px;
    }
    .hero__foto {
      width: 120px;
      height: 120px;
    }
    .blok,
    .blok--vzdelani,
    .blok--dovednosti {
      margin-top: 96px;
    }
    .mrizka {
      grid-template-columns: 1fr;
      row-gap: 36px;
    }
    .skola {
      grid-template-columns: 56px 1fr;
      gap: 16px;
    }
    .skola .logo--64 {
      width: 56px;
      height: 56px;
    }
    .skola__rok {
      grid-column: 2;
      margin-top: -8px;
      text-align: left;
    }
    .zaver {
      margin-top: 96px;
      margin-bottom: 40px;
    }
  }
</style>
