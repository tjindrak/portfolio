---
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import Portret from '../components/Portret.astro';
import Obrazek from '../components/Obrazek.astro';
import Icon from '../components/Icon.astro';
import KontaktFormular from '../components/KontaktFormular.astro';
import sharp from 'sharp';
import { join } from 'node:path';
import { vybraneProjekty, prvniExistujici } from '../lib/projekty';

const vybrane = await vybraneProjekty();

// Poměr stran fotky karty: zavřená karta ukazuje fotku na plnou výšku jako ve Figmě
const karty = await Promise.all(
  vybrane.map(async (p) => {
    const src = prvniExistujici(p.id, ['karta.webp', 'cover.webp']);
    const { width = 4, height = 3 } = await sharp(join(process.cwd(), 'public', src)).metadata().catch(() => ({}));
    return { p, src, pomer: width / height };
  })
);

const sluzby = [
  { nazev: 'UI a produktový design', stitky: ['Weby', 'Aplikace', 'Design systémy'] },
  { nazev: 'UX výzkum', stitky: ['Rozhovory', 'Testování', 'Analýza'] },
  { nazev: 'Grafika a identita', stitky: ['Logo', 'Vizuální styl', 'Tiskoviny'] },
];
---
<Base glow="home">
  <Intro slot="before" />

  <!-- Hero -->
  <section class="hero container">
    <div class="hero__pruhy" aria-hidden="true"></div>
    <Portret class="hero__portret" sklo />
    <div class="hero__text">
      <h1 class="hero__nadpis"><span class="hero__radek"><span>Grafický a UI/UX</span></span> <span class="hero__radek"><span>designer.</span></span></h1>
      <div class="hero__akce">
        <a href="/projekty" class="btn btn--accent">Moje práce</a>
        <a href="/kontakt" class="btn btn--dark">Kontakt</a>
      </div>
    </div>
  </section>

  <!-- Vybrané projekty -->
  <section class="vybrane container" aria-labelledby="vybrane-nadpis">
    <h2 id="vybrane-nadpis" class="vybrane__nadpis" data-reveal>Vybrané projekty</h2>
    <ul class="karty" data-reveal>
      {karty.map(({ p, src, pomer }, i) => (
        <li class:list={['karta', { 'is-open': i === 0 }]} style={`--pomer: ${pomer.toFixed(4)}`}>
          <a href={`/projekty/${p.id}`} class="karta__odkaz">
            <Obrazek src={src} alt={p.data.nazev} class="karta__img" showCaption={false} />
            <span class="karta__scrim" aria-hidden="true"></span>
            <span class="karta__popisek">
              <span class="karta__text">
                <span class="karta__nazev">{p.data.nazev === 'Zahradní centrum DIKÉ' ? 'DIKÉ' : p.data.nazev}</span>
                <span class="karta__meta">{p.data.rok} · {p.data.typ}</span>
              </span>
              <span class="karta__sipka" aria-hidden="true"><Icon name="arrow-up-right" /></span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <div class="vybrane__pata">
      <a href="/projekty" class="btn btn--accent">Všechny projekty</a>
    </div>
  </section>

  <!-- O mně -->
  <section class="omne container" aria-labelledby="omne-nadpis">
    <p class="bg-word omne__slovo" aria-hidden="true">O mně</p>
    <div class="omne__obsah">
      <div class="omne__intro" data-reveal>
        <h2 id="omne-nadpis" class="omne__claim">Jsem designer, který se nejdřív ptá a&nbsp;teprve potom tvoří.</h2>
        <p class="omne__popis">
          Navrhuju digitální produkty od prvního rozhovoru s uživateli až po finální pixel. Pomáhám týmům a značkám zjistit, co lidé
          opravdu potřebují, a proměnit to v rozhraní, která se dobře používají a hezky vypadají.
        </p>
      </div>
      <ul class="sluzby">
        {sluzby.map((s, i) => (
          <li class="sluzba" data-reveal style={`--reveal-delay:${i * 0.1}s`}>
            <span class="sluzba__linka" aria-hidden="true"></span>
            <h3 class="sluzba__nazev">{s.nazev}</h3>
            <p class="sluzba__stitky">{s.stitky.join('  ·  ')}</p>
          </li>
        ))}
      </ul>
      <a href="/o-mne" class="btn btn--accent omne__btn">Celý příběh o mně</a>
    </div>
  </section>

  <!-- Napiš mi -->
  <section class="napis container" aria-labelledby="napis-nadpis">
    <p class="bg-word napis__slovo" aria-hidden="true">Napiš mi</p>
    <div class="napis__obsah">
      <h2 id="napis-nadpis" class="napis__intro" data-reveal>Máš nápad, který si zaslouží dobrý design? Pojďme ho spolu dotáhnout.</h2>
      <KontaktFormular class="napis__formular" kompaktni />
    </div>
  </section>
</Base>

<script>
  // Vybrané projekty: první kliknutí kartu rozbalí, další kliknutí na rozbalenou otevře detail.
  // Na mobilu (karty pod sebou) vede kliknutí rovnou na detail.
  const karty = document.querySelectorAll<HTMLElement>('.karta');
  const pod = matchMedia('(max-width: 900px)');
  karty.forEach((karta) => {
    karta.querySelector('a')?.addEventListener('click', (e) => {
      if (pod.matches || karta.classList.contains('is-open')) return;
      e.preventDefault();
      karty.forEach((k) => k.classList.toggle('is-open', k === karta));
    });
  });
</script>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: 893px;
  }
  .hero__pruhy {
    position: absolute;
    right: -200px;
    top: -180px;
    width: 1100px;
    height: 1100px;
    background: repeating-linear-gradient(111.55deg, rgb(var(--fg-rgb) / 0.018) 0 108px, transparent 108px 216px);
    -webkit-mask-image: radial-gradient(closest-side, #000, transparent);
    mask-image: radial-gradient(closest-side, #000, transparent);
    pointer-events: none;
  }
  .hero :global(.hero__portret) {
    position: absolute;
    left: calc(var(--gutter) + 666px);
    top: 79px;
    width: 592px;
    /* Fotka se ztrácí do pozadí přesně na spodní hraně okna (portrét začíná 180 px od vrchu stránky).
       Na velmi vysokých oknech končí tam, kde končí přechod už v samotné fotce. */
    --konec: min(calc(100svh - 180px), 877px);
    -webkit-mask-image: linear-gradient(180deg, #000 calc(var(--konec) - 320px), transparent var(--konec));
    mask-image: linear-gradient(180deg, #000 calc(var(--konec) - 320px), transparent var(--konec));
  }
  .hero__text {
    position: relative;
    padding-top: 329px;
    max-width: 780px;
  }
  .hero__nadpis {
    font-family: var(--font-heading);
    font-weight: 300;
    font-size: clamp(52px, 6.7vw, 96px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #edeeea;
  }
  :global(:root[data-theme='light']) .hero__nadpis {
    color: var(--fg);
  }
  /* Řádky nadpisu: při úvodní animaci vyjíždějí zespodu z masky */
  .hero__radek {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .hero__radek > span {
    display: block;
  }
  .hero__akce {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 32px;
  }

  /* Vybrané projekty */
  .vybrane {
    position: relative;
    margin-top: 316px;
  }
  .vybrane__nadpis {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(36px, 3.4vw, 48px);
    line-height: 1.1;
  }
  .karty {
    /* Otevřená karta = celá šířka minus tři zavřené karty a tři mezery */
    --zavrena: 160px;
    --otevrena: calc(100cqw - 3 * var(--zavrena) - 3 * 8px);
    container-type: inline-size;
    display: flex;
    gap: 8px;
    height: 450px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }
  .karta {
    position: relative;
    flex: none;
    width: var(--zavrena);
    min-width: 0;
    overflow: hidden;
    border-radius: 10px;
    background: var(--tile-bg);
    transition: width 1.3s cubic-bezier(0.45, 0, 0.2, 1);
  }
  /* Otevřená karta se rozbalí po kliknutí (skript dole), druhé kliknutí vede na detail */
  .karta.is-open {
    width: var(--otevrena);
  }
  .karta__odkaz {
    position: absolute;
    inset: 0;
    display: block;
  }
  /* Zavřená karta ukazuje fotku na plnou výšku (jako ve Figmě), otevřená na šířku karty.
     Šířka fotky se animuje stejně jako karta, takže se plynule zvětší bez cuknutí. */
  .karta :global(.karta__img) {
    position: absolute;
    top: 0;
    left: 50%;
    width: calc(450px * var(--pomer, 1.3333));
    max-width: none;
    height: 100%;
    transform: translateX(-50%);
    transition: width 1.3s cubic-bezier(0.45, 0, 0.2, 1);
  }
  .karta.is-open :global(.karta__img) {
    width: max(var(--otevrena), calc(450px * var(--pomer, 1.3333)));
  }
  .karta__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(10 11 12 / 0) 45%, rgb(10 11 12 / 0.35) 72%, rgb(10 11 12 / 0.75) 100%);
  }
  .karta__popisek {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    padding: 28px;
    color: #fff;
    opacity: 0;
    transition: opacity 0.7s ease;
  }
  .karta.is-open .karta__popisek {
    opacity: 1;
    transition-delay: 0.55s;
  }
  .karta__text {
    display: flex;
    flex-direction: column;
    gap: 6px;
    white-space: nowrap;
  }
  .karta__nazev {
    font-size: 32px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    line-height: 1.1;
  }
  .karta__meta {
    font-size: 14px;
    opacity: 0.8;
  }
  .karta__sipka {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: 50%;
    background: var(--accent-5);
    color: var(--grayscale-10);
  }
  .karta__sipka :global(svg) {
    width: 20px;
    height: 20px;
  }
  .vybrane__pata {
    display: flex;
    justify-content: center;
    margin-top: 32px;
  }

  /* O mně */
  .omne {
    position: relative;
    margin-top: 338px;
    --fs: clamp(100px, 18.06vw, 260px);
  }
  /* Slova v pozadí jsou na hlavní stránce v Nohemi SemiBold (Figma Mainpage) */
  .omne__slovo,
  .napis__slovo {
    font-family: var(--font-heading);
    font-weight: 600;
  }
  .omne__slovo {
    font-size: var(--fs);
    letter-spacing: -0.05em;
  }
  .omne__obsah {
    position: relative;
    /* obsah začíná 16 px pod slovem, nepřekrývá se s ním */
    margin-top: calc(var(--fs) * 0.0615);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 56px;
  }
  .omne__intro {
    max-width: 920px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .omne__claim {
    font-weight: 500;
    font-size: clamp(36px, 4.2vw, 60px);
    line-height: 1.08;
    letter-spacing: -0.025em;
  }
  .omne__popis {
    max-width: 760px;
    font-size: 20px;
    line-height: 1.6;
    color: var(--fg-70);
  }
  .sluzby {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sluzba {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 28px 32px 32px;
  }
  .sluzba__linka {
    width: 40px;
    height: 2px;
    background: var(--accent);
  }
  .sluzba__nazev {
    font-weight: 500;
    font-size: 28px;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .sluzba__stitky {
    font-size: 15px;
    line-height: 1.2;
    font-weight: 400;
    color: var(--fg-40);
    white-space: pre-wrap;
  }

  /* Napiš mi */
  .napis {
    position: relative;
    margin-top: 399px;
    padding-bottom: 5px;
    --fs: clamp(100px, 19.5vw, 280px);
  }
  .napis__slovo {
    font-size: var(--fs);
    text-align: center;
  }
  /* Úvod i formulář tvoří jeden sloupec 821 px uprostřed (Figma: Frame 33) */
  .napis__obsah {
    position: relative;
    max-width: 821px;
    margin-inline: auto;
    /* úvod začíná 24 px pod slovem (výška slova 0,9 × 280 px) */
    margin-top: calc(var(--fs) * 0.0857);
  }
  .napis__intro {
    max-width: 560px;
    font-weight: 500;
    font-size: clamp(24px, 2.1vw, 30px);
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--fg-90);
  }
  .napis :global(.napis__formular) {
    margin-top: 64px;
  }

  @media (max-width: 1200px) {
    .hero :global(.hero__portret) {
      left: auto;
      right: 0;
      width: 46%;
    }
    .hero {
      min-height: 760px;
    }
    .hero__text {
      padding-top: 300px;
    }
  }
  @media (max-width: 900px) {
    .karty {
      flex-direction: column;
      height: auto;
    }
    .karta,
    .karta.is-open {
      width: auto;
      height: 280px;
    }
    .karta :global(.karta__img),
    .karta.is-open :global(.karta__img) {
      left: 0;
      width: 100%;
      transform: none;
    }
    .karta__popisek {
      opacity: 1;
      padding: 20px;
    }
    .karta__nazev {
      font-size: 24px;
    }
    .sluzby {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .sluzba {
      padding: 20px 0;
    }
  }
  @media (max-width: 720px) {
    .hero {
      min-height: 0;
      display: flex;
      flex-direction: column;
    }
    .hero :global(.hero__portret) {
      position: relative;
      left: auto;
      top: 0;
      width: 72%;
      margin: 8px auto -45%;
      -webkit-mask-image: linear-gradient(180deg, #000 55%, transparent 92%);
      mask-image: linear-gradient(180deg, #000 55%, transparent 92%);
    }
    .hero__text {
      padding-top: 0;
    }
    .omne,
    .napis {
      margin-top: 96px;
    }
    .napis :global(.napis__formular) {
      margin-top: 48px;
    }
  }
</style>
