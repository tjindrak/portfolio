---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Obrazek from '../../components/Obrazek.astro';
import ProjektDlazdice from '../../components/ProjektDlazdice.astro';
import Icon from '../../components/Icon.astro';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { vsechnyProjekty, obrazekProjektu, prvniExistujici, type Projekt } from '../../lib/projekty';

export const getStaticPaths = (async () => {
  const projekty = await vsechnyProjekty();
  return projekty.map((projekt) => ({
    params: { slug: projekt.id },
    props: {
      projekt,
      dalsi: projekty.find((p) => p.id === projekt.data.dalsi) ?? projekty.find((p) => p.id !== projekt.id && p.data.stav === 'hotovo'),
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  projekt: Projekt;
  dalsi?: Projekt;
}

const { projekt, dalsi } = Astro.props;
const { id } = projekt;
const d = projekt.data;
const slovo = d.slovo ?? d.nazev;
const brzy = d.stav === 'brzy';

const metaPolozky = [
  ['Klient', d.meta?.klient],
  ['Moje role', d.meta?.role],
  ['Rok', d.meta?.rok],
  ['Výstup', d.meta?.vystup],
  ['Spolupráce', d.meta?.spoluprace],
].filter((m): m is [string, string] => !!m[1]);

const jeCitat = (t: string) => t.startsWith('> ');
const bezCitace = (t: string) => t.replace(/^>\s*/, '');
// Vrstevnice v pozadí stránky (Jardova mapa), když projekt má vrstevnice.svg
const vrstevnice = `/img/projekty/${id}/vrstevnice.svg`;
const maVrstevnice = existsSync(join(process.cwd(), 'public', vrstevnice));
const heroSrc = brzy ? prvniExistujici(id, ['hero.webp', 'cover.webp']) : obrazekProjektu(id, 'hero.webp');
---
<Base title={d.nazev} description={d.shrnuti ?? `${d.nazev} · ${d.typ}`} glow={brzy ? 'brzy' : 'default'} glowBarva={brzy ? undefined : d.barva}>
  <article
    class:list={['detail', `detail--${id}`, { 'detail--barva': !brzy && d.barva, 'detail--brzy': brzy }]}
    style={[!brzy && d.barva && `--projekt: ${d.barva}`, d.velikostSlova && `--slovo-max: ${d.velikostSlova}px`].filter(Boolean).join(';') || undefined}
  >
    {maVrstevnice && <img class="vrstevnice" src={vrstevnice} alt="" aria-hidden="true" />}
    <!-- Hero -->
    <header class="container hero">
      <a href="/projekty" class="btn btn--text hero__zpet nacti"><Icon name="arrow-left" />Všechny projekty</a>
      <p class="bg-word hero__slovo" aria-hidden="true" data-pismena="zespodu">{slovo}</p>
      <h1 class="title-xl hero__nazev"><span class="maska"><span style="--d:0.15s">{d.nazev}</span></span></h1>

      {!brzy && (
        <>
          {d.stitky.length > 0 && (
            <ul class="hero__stitky nacti" style="--d:0.3s">
              {d.stitky.map((s) => <li>{s}</li>)}
            </ul>
          )}
          <div class="hero__radek">
            <div class="hero__levy">
              {d.shrnuti && <p class="lead gradient-text gradient-text--soft hero__shrnuti nacti" style="--d:0.4s">{d.shrnuti}</p>}
              {d.web?.url && (
                <a href={d.web.url} class="btn btn--accent hero__web nacti" style="--d:0.55s" target="_blank" rel="noopener">
                  {d.web.tlacitko} <Icon name="arrow-up-right" />
                </a>
              )}
            </div>
            {metaPolozky.length > 0 && (
              <dl class="meta nacti" style="--d:0.45s">
                {metaPolozky.map(([k, v]) => (
                  <div class="meta__polozka">
                    <dt>{k}</dt>
                    <dd>{v}</dd>
                  </div>
                ))}
              </dl>
            )}
          </div>
        </>
      )}
    </header>

    <!-- Hlavní obrázek -->
    {d.hero?.rozlozeni === 'kolaz' ? (
      <div class="container kolaz" data-reveal>
        <div class="kolaz__velky">
          <Obrazek src={heroSrc} alt={d.hero.popisek} vyrez={d.hero.vyrez} eager />
          <Obrazek src={obrazekProjektu(id, 'hero-logo.svg')} alt="" class="kolaz__logo" fit="contain" showCaption={false} />
        </div>
        <div class="kolaz__maly">
          <Obrazek src={obrazekProjektu(id, 'hero-mobil.webp')} alt={d.hero.popisekMobil ?? d.hero.popisek} vyrez={d.hero.vyrezMobil} />
        </div>
      </div>
    ) : (
      <div class:list={['container hero-obrazek', { 'hero-obrazek--brzy': brzy }]} data-reveal>
        <div class="hero-obrazek__ram">
          <Obrazek src={heroSrc} alt={d.hero?.popisek ?? d.nazev} vyrez={brzy ? undefined : d.hero?.vyrez} eager />
        </div>
      </div>
    )}

    {brzy ? (
      <p class="container brzy subhead gradient-text" data-reveal>
        Copy se ještě píše a pixely se skládají.<br />
        Detaily o tomhle projektu tu najdeš už brzy.
      </p>
    ) : (
      <>
        <!-- Výzva -->
        {d.vyzva && (
          <section class:list={['container sekce sekce--vyzva', { 'sekce--s-obrazkem': d.vyzva.obrazekPozice === 'vedle' && d.vyzva.obrazek }]}>
            <p class="bg-word" aria-hidden="true" data-pismena="zespodu">Výzva</p>
            <div class:list={['sekce__obsah', { 'sekce__obsah--s-obrazkem': d.vyzva.obrazekPozice === 'vedle' && d.vyzva.obrazek }]}>
              {d.vyzva.obrazekPozice === 'vedle' && d.vyzva.obrazek && (
                <div class="obrazek-vedle" data-reveal>
                  <Obrazek src={d.vyzva.obrazek.src} alt={d.vyzva.obrazek.popisek} vyrez={d.vyzva.obrazek.vyrez} />
                </div>
              )}
              <div class="sloupec sloupec--vpravo">
                <h2 class="subhead gradient-text" data-pismena>{d.vyzva.nadpis}</h2>
                <div class="prose">
                  {d.vyzva.odstavce.map((o) => <p data-pismena>{o}</p>)}
                </div>
              </div>
            </div>
            {d.vyzva.obrazekPozice === 'pod' && d.vyzva.obrazek && (
              <div class="obrazek-pod" data-reveal>
                <Obrazek src={d.vyzva.obrazek.src} alt={d.vyzva.obrazek.popisek} vyrez={d.vyzva.obrazek.vyrez} />
              </div>
            )}
          </section>
        )}

        <!-- Proces -->
        {d.proces && (
          <section class="container sekce sekce--proces">
            <p class="bg-word bg-word--vpravo" aria-hidden="true" data-pismena="zespodu">Proces</p>
            <div class="sloupec">
              <h2 class="subhead gradient-text" data-pismena>{d.proces.nadpis}</h2>
              <div class="prose">
                {d.proces.odstavce.map((o) => <p data-pismena>{o}</p>)}
              </div>
            </div>
            {d.proces.kroky.length > 0 && (
              <ol class="kroky">
                {d.proces.kroky.map((k, i) => (
                  <li class="krok" data-reveal style={`--reveal-delay:${i * 0.08}s`}>
                    <span class="krok__linka" aria-hidden="true"></span>
                    <h3 class="krok__nazev">{k.nazev}</h3>
                    <p class="krok__popis">{k.popis}</p>
                  </li>
                ))}
              </ol>
            )}
          </section>
        )}

        <!-- Řešení -->
        {d.reseni && (
          <section class:list={['container sekce sekce--reseni', { 'sekce--dlouhe-slovo': !!d.reseni.slovo }]}>
            <p class="bg-word bg-word--zalom" aria-hidden="true" data-pismena="zespodu">{d.reseni.slovo ?? 'Řešení'}</p>
            <div class="sloupec sloupec--vpravo">
              <h2 class="subhead gradient-text" data-pismena>{d.reseni.nadpis}</h2>
              <div class="prose">
                {d.reseni.odstavce.map((o) => (jeCitat(o) ? <p class="quote gradient-text" data-pismena>{bezCitace(o)}</p> : <p data-pismena>{o}</p>))}
              </div>
            </div>
            {d.reseni.obrazky.length > 0 && (
              <div class:list={['galerie', `galerie--${Math.min(d.reseni.obrazky.length, 2)}`, `galerie--${id}`]}>
                {d.reseni.obrazky.map((o, i) => (
                  <div class="galerie__item" data-reveal style={`--reveal-delay:${i * 0.1}s`}>
                    <Obrazek src={o.src} alt={o.popisek} vyrez={o.vyrez} />
                  </div>
                ))}
              </div>
            )}
            {d.reseni.obrazovky.length > 0 && (
              <ul class="obrazovky">
                {d.reseni.obrazovky.map((o, i) => (
                  <li class="obrazovky__item" data-reveal style={`--reveal-delay:${i * 0.06}s`}>
                    <Obrazek src={o.src} alt={o.popisek} />
                  </li>
                ))}
              </ul>
            )}
            {d.reseni.siroky && (
              <div class="siroky" data-reveal>
                <Obrazek src={d.reseni.siroky.src} alt={d.reseni.siroky.popisek} />
              </div>
            )}
            {d.web?.url && (
              <p class="web-odkaz" data-reveal>
                <a href={d.web.url} class="btn btn--accent" target="_blank" rel="noopener">
                  Navštívit web <Icon name="arrow-up-right" />
                </a>
              </p>
            )}
          </section>
        )}
      </>
    )}

    <!-- Další projekt -->
    {dalsi && (
      <section class="container dalsi" aria-label="Další projekt">
        <p class="bg-word bg-word--vpravo" aria-hidden="true" data-pismena="zespodu">Další projekt</p>
        <div data-reveal>
          <ProjektDlazdice projekt={dalsi} siroka class="dalsi__dlazdice" />
        </div>
      </section>
    )}
  </article>
</Base>

<style>
  /* Světlé nadpisy (Figma „světlé nadpisy“): shrnutí a podnadpisy jdou z bílé do 60 % bílé,
     citace z akcentu do bílé. Barva projektu zůstává jen v záři v pozadí. */
  .detail :global(.gradient-text),
  .detail :global(.gradient-text--soft) {
    background-image: linear-gradient(90deg, var(--fg) 0%, rgb(var(--fg-rgb) / 0.6) 100%);
  }
  .detail :global(.quote.gradient-text) {
    background-image: linear-gradient(90deg, var(--accent-5) 0%, var(--fg) 100%);
  }
  .detail :global(.subhead),
  .detail :global(.prose .quote) {
    font-weight: 400;
  }
  .detail--brzy :global(.gradient-text) {
    background-image: linear-gradient(90deg, var(--fg) 0%, rgb(var(--fg-rgb) / 0.55) 100%);
  }

  /* Rozměry podle Figmy (rámec 1440 px, obsah 1312 px) */

  .detail {
    position: relative;
  }
  .vrstevnice {
    position: absolute;
    top: -101px;
    left: 0;
    z-index: -1;
    width: 100%;
    height: auto;
    pointer-events: none;
    user-select: none;
  }

  /* Hero */
  .hero {
    position: relative;
    padding-top: 49px;
  }
  /* Slova v pozadí detailu jsou v Nohemi SemiBold (Figma) */
  .detail :global(.bg-word) {
    font-family: var(--font-heading);
    font-weight: 600;
  }
  .hero__slovo {
    margin-top: 31px;
    font-size: clamp(88px, 15.5vw, var(--slovo-max, 224px));
  }
  /* Nadpis drží místo i u menšího slova (Jardova mapa 198 px) */
  .hero__nazev {
    position: relative;
    margin-top: calc(21.5px + 0.9 * (224px - var(--slovo-max, 224px)));
  }
  /* Štítky jako jemný text; řádek drží výšku původních chipů */
  .hero__stitky {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
    font-weight: 500;
    line-height: normal;
    color: rgb(var(--fg-rgb) / 0.7);
  }
  .hero__stitky li {
    white-space: nowrap;
  }
  .hero__radek {
    display: grid;
    grid-template-columns: minmax(0, 800px) minmax(0, 316px);
    justify-content: space-between;
    gap: 48px;
    min-height: 362px;
    margin-top: 69px;
  }
  .hero__shrnuti {
    font-weight: 400;
    font-size: clamp(22px, 2.23vw, 32px);
  }
  .hero__web,
  .web-odkaz .btn {
    font-weight: 400;
  }
  .hero__web {
    margin-top: 40px;
  }
  /* Údaje začínají na úrovni štítků a končí u tlačítka (Figma: Meta y 544) */
  .meta {
    display: flex;
    flex-direction: column;
    gap: 22px;
    margin: -87px 0 0;
  }
  .meta dt {
    font-size: 13px;
    font-weight: 500;
    line-height: 16px;
    color: var(--fg-60);
  }
  .meta dd {
    margin: 4px 0 0;
    font-size: 17px;
    font-weight: 400;
    line-height: normal;
    color: var(--fg);
  }

  /* Hlavní obrázek */
  .hero-obrazek__ram,
  .kolaz__velky,
  .kolaz__maly,
  .obrazek-vedle,
  .obrazek-pod,
  .galerie__item {
    position: relative;
    overflow: hidden;
  }
  .hero-obrazek__ram {
    aspect-ratio: 1312 / 720;
  }
  .hero-obrazek__ram :global(.obrazek) {
    position: absolute;
    inset: 0;
  }
  .hero-obrazek--brzy {
    margin-top: 80px;
  }
  .kolaz {
    position: relative;
    padding-bottom: 228px;
  }
  .kolaz__velky {
    margin-left: 14.86%;
    width: 84.76%;
    aspect-ratio: 1112 / 640;
    border-radius: var(--radius-media);
  }
  .kolaz__velky :global(.obrazek) {
    position: absolute;
    inset: 0;
  }
  .kolaz__velky :global(.kolaz__logo) {
    pointer-events: none;
  }
  .kolaz__velky :global(.obrazek--placeholder.kolaz__logo) {
    display: none;
  }
  .kolaz__maly {
    position: absolute;
    left: calc(var(--gutter) + (100% - 2 * var(--gutter)) * 0.0229);
    top: 228px;
    width: calc((100% - 2 * var(--gutter)) * 0.3361);
    aspect-ratio: 441 / 640;
    border-radius: var(--radius-media);
  }

  /* Sekce s velkým slovem v pozadí */
  .sekce {
    position: relative;
    margin-top: 300px;
  }
  .sekce--vyzva {
    margin-top: 340px;
  }
  .kolaz + .sekce--vyzva {
    margin-top: 360px;
  }
  .sekce--s-obrazkem + .sekce {
    margin-top: 240px;
  }
  .sekce--reseni {
    margin-top: 360px;
  }
  .sekce .bg-word,
  .dalsi .bg-word {
    font-size: clamp(88px, 15.28vw, 220px);
  }
  .bg-word--vpravo {
    text-align: right;
  }
  .bg-word--zalom {
    white-space: normal;
  }
  .sekce__obsah--s-obrazkem {
    display: grid;
    grid-template-columns: var(--col-offset) 1fr;
    align-items: start;
  }
  .sekce__obsah--s-obrazkem .sloupec--vpravo {
    margin-left: 0;
  }
  .obrazek-vedle {
    width: 441px;
    max-width: calc(100% - 48px);
    aspect-ratio: 441 / 640;
    margin-top: 270px;
  }
  .sloupec {
    position: relative;
    max-width: 820px;
    margin-top: 77px;
  }
  .sekce--vyzva .sloupec {
    margin-top: 130px;
  }
  .sekce--reseni .sloupec {
    margin-top: 53px;
  }
  .sekce--dlouhe-slovo .sloupec {
    margin-top: 136px;
  }
  .sloupec--vpravo {
    margin-left: var(--col-offset);
  }
  .sloupec .prose {
    margin-top: 42px;
  }
  .sekce--vyzva .sloupec .prose {
    margin-top: 72px;
  }
  .obrazek-pod {
    width: 67.7%;
    aspect-ratio: 888 / 780;
    margin: 200px 0 0 6%;
    border-radius: var(--radius-media);
  }

  .kroky {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 272px));
    gap: 64px;
    margin: 180px 0 0;
    padding: 0;
    list-style: none;
  }
  .krok__linka {
    display: block;
    width: 40px;
    height: 2px;
    background: var(--accent);
  }
  .krok__nazev {
    margin-top: 26px;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 28px;
    line-height: normal;
  }
  .krok__popis {
    margin-top: 11px;
    font-size: 18px;
    line-height: 1.5;
    color: var(--fg-80);
  }

  .galerie {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px;
    margin-top: 180px;
  }
  .galerie__item {
    border-radius: var(--radius-media);
    aspect-ratio: 620 / 440;
  }
  .galerie__item :global(.obrazek) {
    position: absolute;
    inset: 0;
  }
  .galerie__item:nth-child(2) {
    margin-top: 80px;
  }
  .galerie--1 {
    grid-template-columns: 1fr;
  }
  /* Jardova mapa: vyšší telefon vlevo, širší detail vpravo (jako ve Figmě) */
  .galerie--jardova-mapa {
    grid-template-columns: 566fr 662fr;
    gap: 17px;
    margin-top: 200px;
    padding-left: 5.1%;
  }
  .galerie--jardova-mapa .galerie__item:nth-child(1) {
    aspect-ratio: 566 / 694;
  }
  .galerie--jardova-mapa .galerie__item:nth-child(2) {
    aspect-ratio: 662 / 509;
    margin-top: 251px;
  }
  .siroky {
    margin-top: 200px;
    aspect-ratio: 1312 / 546;
    overflow: hidden;
  }
  .obrazovky {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin: 267px 0 0;
    padding: 0;
    list-style: none;
  }
  .obrazovky__item {
    flex: 0 1 252px;
    aspect-ratio: 252 / 546;
  }
  .web-odkaz {
    max-width: 820px;
    margin: 120px auto 0;
    text-align: center;
  }
  .galerie + .web-odkaz {
    margin-top: 340px;
  }
  .obrazovky + .web-odkaz {
    margin-top: 140px;
  }

  .brzy {
    margin-top: 160px;
    text-align: center;
  }

  .dalsi {
    position: relative;
    margin-top: 360px;
  }
  @media (min-width: 1101px) {
    /* Slovo Proces přesahuje ve Figmě pravý okraj obsahu až na x 1408 */
    .sekce--proces .bg-word {
      margin-right: -32px;
    }
  }
  /* Jardova mapa: vlastní rozestupy z Figmy (438:414) */
  @media (min-width: 1101px) {
    .detail--jardova-mapa .sekce--proces {
      margin-top: 300px;
    }
    .detail--jardova-mapa .kroky {
      margin-top: 180px;
    }
    .detail--jardova-mapa .sekce--reseni {
      margin-top: 360px;
    }
  }
  .dalsi :global(.dalsi__dlazdice) {
    margin-top: 38px;
    height: 460px;
  }

  @media (max-width: 1100px) {
    .hero__radek {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .hero-obrazek,
    .kolaz {
      margin-top: 80px;
    }
    .meta {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      margin-top: 8px;
    }
    .kroky {
      grid-template-columns: repeat(2, 1fr);
      gap: 48px;
    }
    .obrazovky {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
    }
    .obrazovky__item {
      flex: 0 0 220px;
      scroll-snap-align: start;
    }
  }
  @media (max-width: 720px) {
    .hero {
      padding-top: 24px;
    }
    .hero__radek {
      margin-top: 32px;
    }
    .hero-obrazek__ram {
      aspect-ratio: 4 / 3;
    }
    .kolaz {
      padding-bottom: 0;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .kolaz__velky {
      margin: 0;
      width: 100%;
    }
    .kolaz__maly {
      position: relative;
      left: auto;
      top: auto;
      width: 60%;
    }
    .sekce,
    .sekce--vyzva,
    .sekce--reseni,
    .kolaz + .sekce--vyzva,
    .sekce--s-obrazkem + .sekce {
      margin-top: 160px;
    }
    .sloupec,
    .sekce--vyzva .sloupec,
    .sekce--reseni .sloupec,
    .sekce--dlouhe-slovo .sloupec {
      margin-top: -16px;
    }
    .sloupec .prose,
    .sekce--vyzva .sloupec .prose {
      margin-top: 32px;
    }
    .sekce__obsah--s-obrazkem {
      display: flex;
      flex-direction: column-reverse;
      gap: 40px;
    }
    .obrazek-vedle {
      margin-top: 0;
      max-width: 100%;
      width: 100%;
    }
    .obrazek-pod {
      width: 100%;
      margin-left: 0;
      margin-top: 48px;
    }
    .kroky {
      grid-template-columns: 1fr;
      gap: 36px;
      margin-top: 64px;
    }
    .galerie,
    .galerie--jardova-mapa {
      grid-template-columns: 1fr;
      gap: 16px;
      padding: 0;
      margin-top: 64px;
    }
